/td>\n<td>渲染气球升力箭头</td>\n</tr>\n<tr>\n<td>显示推进</td>\n<td>✅</td>\n<td>渲染推进力箭头</td>\n</tr>\n<tr>\n<td>显示升力</td>\n<td>✅</td>\n<td>渲染升力箭头</td>\n</tr>\n<tr>\n<td>显示磁力</td>\n<td>✅</td>\n<td>渲染磁力箭头</td>\n</tr>\n</tbody>\n</table>\n<h4>其他</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>移除机械臂限制</td>\n<td>❌</td>\n<td>移除机械臂的距离限制</td>\n</tr>\n<tr>\n<td>移除请求限制</td>\n<td>✅</td>\n<td>移除工厂面板和红石请求器的请求数量限制，优化快速滚动</td>\n</tr>\n<tr>\n<td>库存请求快捷操作</td>\n<td>✅</td>\n<td>启用库存请求界面的快捷操作</td>\n</tr>\n<tr>\n<td>递归图纸扫描</td>\n<td>✅</td>\n<td>刷新列表时包含子文件夹中的图纸</td>\n</tr>\n<tr>\n<td>防止选中项丢弃</td>\n<td>✅</td>\n<td>切换物品时防止丢弃选中项</td>\n</tr>\n<tr>\n<td>防止自动关闭过滤器</td>\n<td>❌</td>\n<td>防止过滤器界面自动关闭</td>\n</tr>\n<tr>\n<td>无限编辑框长度</td>\n<td>❌</td>\n<td>无限编辑框长度（实际为 2^31 - 1）</td>\n</tr>\n<tr>\n<td>移除纸箱覆盖</td>\n<td>✅</td>\n<td>潜行时移除纸箱视野遮挡</td>\n</tr>\n<tr>\n<td>移除外置背囊第一人称</td>\n<td>❌</td>\n<td>移除外置下界合金背囊的第一人称渲染效果</td>\n</tr>\n<tr>\n<td>允许潜水靴</td>\n<td>✅</td>\n<td>潜水靴功能，禁用使其像普通靴子一样工作</td>\n</tr>\n<tr>\n<td>修复图纸名称</td>\n<td>✅</td>\n<td>保存图纸时允许非ASCII字符</td>\n</tr>\n<tr>\n<td>移除火车伤害</td>\n<td>❌</td>\n<td>防止火车碰撞对玩家造成伤害</td>\n</tr>\n<tr>\n<td>启用负无穷油门</td>\n<td>❌</td>\n<td>允许火车油门滚动超过正常最小限制</td>\n</tr>\n<tr>\n<td>强制飞轮后端</td>\n<td>❌</td>\n<td>强制启用Flywheel渲染后端（与着色器冲突）</td>\n</tr>\n<tr>\n<td>NBT修复</td>\n<td>❌</td>\n<td>修复因NBT过长导致的崩溃，可能导致卡顿</td>\n</tr>\n<tr>\n<td>显示废料内容</td>\n<td>✅</td>\n<td>显示序列组装中随机废料的具体内容</td>\n</tr>\n</tbody>\n</table>\n<h5>链式传送带</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>始终允许骑乘链式传送带</td>\n<td>❌</td>\n<td>无需扳手即可悬挂在链式传送带上</td>\n</tr>\n<tr>\n<td>防止自动脱离</td>\n<td>❌</td>\n<td>防止因障碍物导致自动脱离链式传送带</td>\n</tr>\n<tr>\n<td>增强连接</td>\n<td>✅</td>\n<td>移除链式传送带的最小距离和最大角度限制</td>\n</tr>\n<tr>\n<td>自动纸箱化</td>\n<td>❌</td>\n<td>悬挂在链条上时自动变为纸箱</td>\n</tr>\n</tbody>\n</table>\n<h5>扳手</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>更好的包覆齿轮</td>\n<t