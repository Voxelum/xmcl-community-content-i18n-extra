  "content": "你好世界你好世界\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>额外物品提示</td>\n<td>✅</td>\n<td>在物品提示中显示额外信息</td>\n</tr>\n<tr>\n<td>属性过滤</td>\n<td>✅</td>\n<td>显示属性过滤详情</td>\n</tr>\n<tr>\n<td>背囊</td>\n<td>✅</td>\n<td>显示背囊的额外提示信息</td>\n</tr>\n<tr>\n<td>剪贴板</td>\n<td>✅</td>\n<td>启用第一人称和提示覆盖层中的剪贴板自定义渲染</td>\n</tr>\n<tr>\n<td>容器</td>\n<td>✅</td>\n<td>显示容器内容</td>\n</tr>\n<tr>\n<td>粉碎控制器</td>\n<td>✅</td>\n<td>显示粉碎控制器的输出和进度</td>\n</tr>\n<tr>\n<td>部署器</td>\n<td>✅</td>\n<td>显示部署器的溢出物品</td>\n</tr>\n<tr>\n<td>仓库</td>\n<td>✅</td>\n<td>显示仓库内容</td>\n</tr>\n<tr>\n<td>潜水靴</td>\n<td>✅</td>\n<td>显示潜水靴的额外提示信息</td>\n</tr>\n<tr>\n<td>末影箱</td>\n<td>✅</td>\n<td>显示末影箱内容</td>\n</tr>\n<tr>\n<td>流体容器</td>\n<td>✅</td>\n<td>显示流体容器内容</td>\n</tr>\n<tr>\n<td>护目镜</td>\n<td>✅</td>\n<td>显示护目镜的额外提示信息</td>\n</tr>\n<tr>\n<td>物品实体</td>\n<td>✅</td>\n<td>显示携带的物品信息</td>\n</tr>\n<tr>\n<td>链接控制器</td>\n<td>✅</td>\n<td>显示链接控制器的频率槽位</td>\n</tr>\n<tr>\n<td>列表过滤</td>\n<td>✅</td>\n<td>显示列表过滤内容</td>\n</tr>\n<tr>\n<td>地图</td>\n<td>✅</td>\n<td>显示地图的额外提示信息</td>\n</tr>\n<tr>\n<td>磨粉机</td>\n<td>✅</td>\n<td>显示磨粉机的额外提示信息</td>\n</tr>\n<tr>\n<td>包裹实体</td>\n<td>✅</td>\n<td>显示包裹实体的内容</td>\n</tr>\n<tr>\n<td>包裹物品</td>\n<td>✅</td>\n<td>显示包裹物品的内容</td>\n</tr>\n<tr>\n<td>红石请求器</td>\n<td>✅</td>\n<td>显示红石请求器的内容</td>\n</tr>\n<tr>\n<td>桌布</td>\n<td>✅</td>\n<td>显示桌布的内容</td>\n</tr>\n<tr>\n<td>工具箱</td>\n<td>✅</td>\n<td>显示工具箱的内容</td>\n</tr>\n<tr>\n<td>扳手</td>\n<td>✅</td>\n<td>显示扳手的额外提示信息</td>\n</tr>\n</tbody>\n</table>\n<h4>覆盖层</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>渲染物品覆盖层</td>\n<td>✅</td>\n<td>允许在方块上渲染物品信息覆盖层</td>\n</tr>\n<tr>\n<td>覆盖层偏移</td>\n<td>0, 0</td>\n<td>物品信息覆盖层的水平和垂直偏移量</td>\n</tr>\n<tr>\n<td>提示标志类型</td>\n<td>默认</td>\n<td>选择提示显示类型</td>\n</tr>\n<tr>\n<td>提示主题</td>\n<td>默认</td>\n<td>选择提示主题样式</td>\n</tr>\n<tr>\n<td>使用自定义颜色</td>\n<td>❌</td>\n<td>启用物品信息覆盖层的自定义颜色</td>\n</tr>\n<tr>\n<td>背景颜色</td>\n<td>0x00000000</td>\n<td>自定义背景颜色</td>\n</tr>\n<tr>\n<td>顶部边框颜色</td>\n<td>0x00000000</td>\n<td>自定义顶部边框颜色</td>\n</tr>\n<tr>\n<td>底部边框颜色</td>\n<td>0x00000000</td>\n<td>自定义底部边框颜色</td>\n</tr>\n</tbody>\n</table>\n<h5>草图视图</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>启用草图视图</td>\n<td>❌</td>\n<td>对整个屏幕应用蓝图/示意图后处理效果</td>\n</tr>\n<tr>\n<td>调色板偏移</td>\n<td>0.25</td>\n<td>水平查找偏移量（0..1），用于定位调色板纹理</td>\n</tr>\n<tr>\n<td>像素化</td>\n<td>✅</td>\n<td>将屏幕吸附到更粗糙的虚拟网格，呈现蓝图外观</td>\n</tr>\n<tr>\n<td>像素缩放</td>\n<td>4</td>\n<td>每个虚拟像素覆盖的屏幕像素数量（1=关闭）</td>\n</tr>\n<tr>\n<td>线条颜色</td>\n<td>0x2E3032</td>\n<td>边缘轮廓颜色</td>\n</tr>\n<tr>\n<td>线条阴影颜色</td>\n<td>0x696965</td>\n<td>深度提示轮廓的阴影侧颜色</td>\n</tr>\n</tbody>\n</table>\n<h4>大纲视图</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>渲染模拟盒</td>\n<td>✅</td>\n<td>渲染由各种方块显示的模拟盒</td>\n</tr>\n<tr>\n<td>更好的线条</td>\n<td>✅</td>\n<td>优化部分渲染的连接线</td>\n</tr>\n<tr>\n<td>延迟渲染持续时间</td>\n<td>60</td>\n<td>模拟盒继续渲染的持续时间 [刻]</td>\n</tr>\n<tr>\n<td>向外颜色</td>\n<td>#DDC166</td>\n<td>当模拟盒朝外时显示的颜色</td>\n</tr>\n<tr>\n<td>向内颜色</td>\n<td>#7FCDE0</td>\n<td>当模拟盒朝内时显示的颜色</td>\n</tr>\n<tr>\n<td>彩虹调试</td>\n<td>❌</td>\n<td>启用彩虹调试模式</td>\n</tr>\n</tbody>\n</table>\n<h4>航空学</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>始终显示质量</td>\n<td>✅</td>\n<td>显示任何方块的质量</td>\n</tr>\n<tr>\n<td>始终显示摩擦力</td>\n<td>❌</td>\n<td>显示任何方块的摩擦力</td>\n</tr>\n<tr>\n<td>提升手柄范围限制</td>\n<td>❌</td>\n<td>提升铁制手柄的范围限制</td>\n</tr>\n<tr>\n<td>自定义手柄移动子层级键</td>\n<td>❌</td>\n<td>启用手柄移动的子层级自定义按键</td>\n</tr>\n<tr>\n<td>始终允许骑乘绳索</td>\n<td>✅</td>\n<td>无需扳手即可挂在绳索上</td>\n</tr>\n</tbody>\n</table>\n<h5>力量覆盖层</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>启用力量覆盖层</td>\n<td>✅</td>\n<td>在目标子层级上渲染世界中的力量箭头和质心标记</td>\n</tr>\n<tr>\n<td>启用力量提示</td>\n<td>✅</td>\n<td>显示带有质量和力幅度的HUD提示</td>\n</tr>\n<tr>\n<td>渲染质心</td>\n<td>✅</td>\n<td>渲染质心立方体标记</td>\n</tr>\n<tr>\n<td>覆盖层位置</td>\n<td>0, 0</td>\n<td>HUD提示位置偏移</td>\n</tr>\n<tr>\n<td>聚类角度阈值</td>\n<td>0.1</td>\n<td>力量聚类的角度方差阈值（弧度）</td>\n</tr>\n<tr>\n<td>平滑因子</td>\n<td>0.5</td>\n<td>EMA平滑因子（0=无变化，1=即时）</td>\n</tr>\n<tr>\n<td>重力箭头分数</td>\n<td>0.5</td>\n<td>重力箭头长度占包围盒高度的比例</td>\n</tr>\n<tr>\n<td>箭头饱和度</td>\n<td>3</td>\n<td>控制大力如何映射到箭头长度</td>\n</tr>\n<tr>\n<td>最小箭头长度</td>\n<td>0.1</td>\n<td>以方块单位计算的最小箭头长度</td>\n</tr>\n<tr>\n<td>目标范围</td>\n<td>4</td>\n<td>用于定位子层级的最大射线投射距离（以区块为单位）</td>\n</tr>\n<tr>\n<td>最小覆盖层像素大小</td>\n<td>0</td>\n<td>覆盖层元素的最小视觉尺寸（以像素为单位）</td>\n</tr>\n<tr>\n<td>显示重力</td>\n<td>✅</td>\n<td>渲染重力箭头</td>\n</tr>\n<tr>\n<td>显示阻力</td>\n<td>✅</td>\n<td>渲染阻力箭头</td>\n</tr>\n<tr>\n<td>显示悬浮</td>\n<td>✅</td>\n<td>渲染悬浮力箭头</td>\n</tr>\n<tr>\n<td>显示气球升力</td>\n<td>✅</td>\n<td>渲染气球升力箭头</td>\n</tr>\n<tr>\n<td>显示推进力</td>\n<td>✅</td>\n<td>渲染推进力箭头</td>\n</tr>\n<tr>\n<td>显示升力</td>\n<td>✅</td>\n<td>渲染升力箭头</td>\n</tr>\n<tr>\n<td>显示磁力</td>\n<td>✅</td>\n<td>渲染磁力箭头</td>\n</tr>\n</tbody>\n</table>\n<h4>杂项</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>移除机械臂限制</td>\n<td>❌</td>\n<td>移除机械臂的距离限制</td>\n</tr>\n<tr>\n<td>移除请求限制</td>\n<td>✅</td>\n<td>移除工厂面板和红石请求器的请求数量限制，优化快速滚动</td>\n</tr>\n<tr>\n<td>库存请求快捷操作</td>\n<td>✅</td>\n<td>在库存请求界面启用快捷操作</td>\n</tr>\n<tr>\n<td>递归图纸扫描</td>\n<td>✅</td>\n<td>刷新列表时包含子文件夹中的图纸</td>\n</tr>\n<tr>\n<td>防止选择丢弃</td>\n<td>✅</td>\n<td>切换物品时防止丢弃选择</td>\n</tr>\n<tr>\n<td>防止自动关闭过滤器</td>\n<td>❌</td>\n<td>防止过滤器界面自动关闭</td>\n</tr>\n<tr>\n<td>无限编辑框长度</td>\n<td>❌</td>\n<td>无限编辑框长度（实际上是 2^31 - 1）</td>\n</tr>\n<tr>\n<td>移除纸箱遮挡</td>\n<td>✅</td>\n<td>潜行时移除纸箱视野遮挡</td>\n</tr>\n<tr>\n<td>移除下界合金背囊第一人称</td>\n<td>❌</td>\n<td>移除下界合金背囊的第一人称渲染效果</td>\n</tr>\n<tr>\n<td>允许潜水靴</td>\n<td>✅</td>\n<td>启用潜水靴功能，禁用使其像普通靴子一样工作</td>\n</tr>\n<tr>\n<td>修复图纸名称</td>\n<td>✅</td>\n<td>保存图纸时允许使用非ASCII字符</td>\n</tr>\n<tr>\n<td>移除火车伤害</td>\n<td>❌</td>\n<td>防止火车碰撞对玩家造成伤害</td>\n</tr>\n<tr>\n<td>启用负无穷节流阀</td>\n<td>❌</td>\n<td>允许火车节流阀滚动超过正常最小限制</td>\n</tr>\n<tr>\n<td>强制启用飞轮后端</td>\n<td>❌</td>\n<td>强制启用Flywheel渲染后端（与着色器冲突）</td>\n</tr>\n<tr>\n<td>NBT修复</td>\n<td>❌</td>\n<td>修复因NBT过长导致的崩溃，可能会导致卡顿</td>\n</tr>\n<tr>\n<td>显示废料内容</td>\n<td>✅</td>\n<td>在序列组装中显示随机废料的特定内容</td>\n</tr>\n</tbody>\n</table>\n<h5>链式传送带</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>始终允许骑乘链条</td>\n<td>❌</td>\n<td>无需扳手即可挂在链式传送带上</td>\n</tr>\n<tr>\n<td>防止自动脱离</td>\n<td>❌</td>\n<td>防止因障碍物导致从链式传送带上自动脱离</td>\n</tr>\n<tr>\n<td>增强连接</td>\n<td>✅</td>\n<td>移除链式传送带的最小距离和最大角度限制</td>\n</tr>\n<tr>\n<td>自动纸板化自身</td>\n<td>❌</td>\n<td>挂在链条上时自动变成纸箱</td>\n</tr>\n</tbody>\n</table>\n<h5>扳手</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>更好的包覆齿轮</td>\n<td>✅</td>\n<td>允许空手右键切换包覆齿轮的状态</td>\n</tr>\n<tr>\n<td>更好的包覆管道</td>\n<td>✅</td>\n<td>允许空手右键切换包覆管道的状态</td>\n</tr>\n<tr>\n<td>更好的底盘</td>\n<td>✅</td>\n<td>允许空手右键切换底盘的粘滞状态</td>\n</tr>\n<tr>\n<td>始终显示滚动值</td>\n<td>✅</td>\n<td>始终在方块上显示滚动值</td>\n</tr>\n<tr>\n<td>始终允许旋转</td>\n<td>✅</td>\n<td>无需扳手即可使用快捷键旋转方块</td>\n</tr>\n<tr>\n<td>左键快速拆除</td>\n<td>✅</td>\n<td>左键瞬间拆除组件</td>\n</tr>\n<tr>\n<td>移除冷却时间</td>\n<td>✅</td>\n<td>移除方块旋转菜单的冷却时间</td>\n</tr>\n<tr>\n<td>增强旋转菜单</td>\n<td>❌</td>\n<td>允许旋转菜单修改更多方块属性</td>\n</tr>\n</tbody>\n</table>\n<h3>热键</h3>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>默认值</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>打开配置</td>\n<td>未绑定</td>\n</tr>\n<tr>\n<td>通过库存ticker访问网络存储</td>\n<td>未绑定</td>\n</tr>\n<tr>\n<td>预览过滤器</td>\n<td>未绑定</td>\n</tr>\n<tr>\n<td>显示应力网络信息</td>\n<td>Tab</td>\n</tr>\n<tr>\n<td>显示超级胶水</td>\n<td>未绑定</td>\n</tr>\n<tr>\n<td>显示蜂蜜胶水</td>\n<td>未绑定</td>\n</tr>\n<tr>\n<td>切换潜水靴开/关</td>\n<td>未绑定</td>\n</tr>\n<tr>\n<td>切换护目镜开/关</td>\n<td>未绑定</td>\n</tr>\n<tr>\n<td>切换要显示的物品</td>\n<td>左Control</td>\n</tr>\n<tr>\n<td>穿过机械结构交互</td>\n<td>左Control</td>\n</tr>\n<tr>\n<td>库存请求全选</td>\n<td>左Alt</td>\n</tr>\n<tr>\n<td>打开库存请求数量设置</td>\n<td>鼠标中键</td>\n</tr>\n<tr>\n<td>交互对面方块面</td>