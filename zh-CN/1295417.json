, 23);border-width:1px\"><strong>5</strong></th>\n<th style=\"width:16.02%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>5</strong></th>\n<th style=\"width:17.1464%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>5</strong></th>\n</tr>\n<tr>\n<th style=\"width:52.5657%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>&nbsp; 攻击速度</strong></th>\n<th style=\"width:14.1427%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>1.1</strong></th>\n<th style=\"width:16.02%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>1.2</strong></th>\n<th style=\"width:17.1464%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>1</strong></th>\n</tr>\n<tr>\n<th style=\"width:52.5657%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>&nbsp; 耐久度</strong></th>\n<th style=\"width:14.1427%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>600</strong></th>\n<th style=\"width:16.02%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>200</strong></th>\n<th style=\"width:17.1464%;border-color:rgb(207, 72, 23);border-width:1px\"><strong>200</strong></th>\n</tr>\n</tbody>\n</table><div class=\"spoiler\">\n<p><img src=\"https://media.forgecdn.net/attachments/description/1295417/description_29c9c78a-79ee-46b1-9fde-fcfe9fd5c4f4.png\" width=\"350\"><img src=\"https://media.forgecdn.net/attachments/description/1295417/description_a09c2c8b-7cfc-40c9-872f-134b7014d622.png\" width=\"350\"><img src=\"https://media.forgecdn.net/attachments/description/1295417/description_70a90e3d-82a7-4678-b6d0-3cdcefafd711.png\" width=\"350\"></p>\n</div><p>&nbsp;</p><hr><p><img src=\"https://media.forgecdn.net/attachments/description/null/description_ec80bb31-b609-416d-af64-61f3f4960ae1.png\" width=\"881\" height=\"147\"></p><p><img src=\"https://media.forgecdn.net/attachments/description/null/description_84ad5838-80f7-4417-8621-b4c853dade6f.png\" width=\"793\" height=\"714\"></p><p><img src=\"https://media.forgecdn.net/attachments/description/null/descri