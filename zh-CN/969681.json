/span></strong></span></li>\n<li>justlevelingfork<span style=\"color:#f1c40f\"><strong><span style=\"color:#ba372a\">&nbsp;♥</span></strong></span></li>\n<li>loot_journal<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>malum<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>map_atlases</li>\n<li>mekanismadditions</li>\n<li>mekanismgenerators</li>\n<li>miners_delight</li>\n<li>modernworldcreation<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>moresnifferflowers<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>mowziesmobs<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>netherchested</li>\n<li>mutantmonsters<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>nethersdelight</li>\n<li>obscure_tooltips<span style=\"color:#f1c40f\"><span style=\"color:#f1c40f\">&nbsp;</span></span><span style=\"color:#f1c40f\"><span style=\"color:#f1c40f\"><strong><span style=\"color:#ba372a\">♥</span></strong></span></span></li>\n<li>oreexcavation</li>\n<li>overflowingbars</li>\n<li>rechiseled</li>\n<li>refurbished_furniture</li>\n<li>regions_unexplored</li>\n<li>reliquary<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>rootsclassic<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>rpghud</li>\n<li>rpgstats</li>\n<li>scguns</li>\n<li>scholar</li>\n<li>simplehealthbar</li>\n<li>sons_of_sins<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>stardew_fishing<span style=\"color:#f1c40f\"><strong><span style=\"color:#ba372a\">&nbsp;♥</span></strong></span></li>\n<li>stylisheffects</li>\n<li>supplementaries<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>tconstruct<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>terra_entity</li>\n<li>terrastorage</li>\n<li>toolbelt</li>\n<li>trade_cycling</li>\n<li>trashslot<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>travelersbackpack<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>trials</li>\n<li>twilightforest<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>unionlib</li>\n<li>universal_graves</li>\n<li>unusualend<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>upgrade_aquatic<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>usefulbackpacks<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>vanillabackport<span style=\"color:#f1c40f\"><span style=\"color:#f1c40f\"><strong><span style=\"color:#ba372a\">&nbsp;♥</span></strong></span></span></li>\n<li>vc_gliders<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>vendingblock</li>\n<li>wardrobe</li>\n<li>waystones<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n<li>woodworks<span style=\"color:#f1c40f\"><span style=\"color:#f1c40f\">&nbsp;<strong><span style=\"color:#ba372a\">♥</span></strong></span></span></li>\n<li>xaerobetterpvp<strong><span style=\"color:#ba372a\"> ♥</span></strong></li>\n</ol>\n</div><p><strong>&nbsp;如果你喜欢我的像素艺术风格，也可以试试：</strong></p><div class=\"spoiler\">\n<p>&nbsp;</p>\n<p><a href=\"https://www.curseforge.com/minecraft/texture-packs/mandalas-brewing-guide-on\" rel=\"nofollow\">Mandala's - 酿造指南开启</a> [原版]<br><br></p>\n<p><a href=\"https://www.curseforge.com/minecraft/texture-packs/mandalas-gui-dark-mode\" rel=\"nofollow\">Mandala's GUI - 深色模式<br></a><a href=\"https://legacy.curseforge.com/minecraft/texture-packs/mandalas-gui-white-mode\" rel=\"nofollow\">Mandala's GUI - 浅色模式</a> <br><br></p>\n<p><a href=\"https://www.curseforge.com/minecraft/texture-packs/fantasy-ores-by-cesarzorak\" rel=\"nofollow\">CesarZorak 的幻想矿石</a></p>\n<p><a href=\"https://www.curseforge.com/minecraft/texture-packs/fantasy-ores-modded-by-cesarzorak\" rel=\"nofollow\">CesarZorak 的幻想矿石</a> [模组版]&nbsp;</p>\n<p>&nbsp;</p>\n</div><p><br><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/SU3whMm.png\" alt=\"\" width=\"1200\" height=\"34\"><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/fpeqHMC.png\" alt=\"\" width=\"1152\" height=\"300\"><a href=\"/linkout?remoteUrl=https%253a%252f%252fbisecthosting.com%252fZorak\" rel=\"nofollow\"><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/4r5WLBc.png\" width=\"1152\" height=\"300\"></a><br><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/SU3whMm.png\" alt=\"\" width=\"1200\" height=\"34\"></p><p style=\"text-align:center\"><strong>💝 亲爱的赞助者们 💝</strong>&nbsp;</p><p style=\"text-align:center\"><em>请记住，你可以在官方的 <a href=\"https://www.patreon.com/mandalacreations\" rel=\"nofollow\">Mandala Creations Patreon</a> 上支持我们，那里有关于即将到来的更新的信息，<br>这有助于我们为你带来最佳品质。</em></p><p><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/SU3whMm.png\" alt=\"\" width=\"1200\" height=\"34\"><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/EjFOwtq.png\" width=\"1152\" height=\"550\"></p>",
