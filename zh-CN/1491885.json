"Discord\"></a></p>\n<h2>✨ 功能特性</h2>\n<ul>\n<li>当 resourcepacks 文件夹内容发生变化时自动重载资源包（源自原版 <a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fproject%252f8xOCApGi\" target=\"_blank\" rel=\"nofollow\">模组</a>）。</li>\n<li>防止在 Linux 和 macOS 上重复调用 reloadResources()</li>\n<li>已移植至 Forge 和 NeoForge</li>\n<li>支持 Resourcify</li>\n</ul>\n<h2>🔄 版本支持</h2>\n<table>\n<thead>\n<tr>\n<th>Minecraft</th>\n<th>Fabric</th>\n<th>Forge</th>\n<th>NeoForge</th>\n<th>Quilt</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1.18.x</td>\n<td>✅</td>\n<td>❌</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.19.x</td>\n<td>✅</td>\n<td>❌</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.20.1</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.20.2</td>\n<td>✅</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.20.3</td>\n<td>✅</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.20.4</td>\n<td>✅</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.20.5</td>\n<td>✅</td>\n<td>❌</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.20.6</td>\n<td>✅</td>\n<td>❌</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.1</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.2</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.3</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.4</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.5</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.6</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.7</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.8</td>\n<td>✅</td>\n<td>❌</td>\n<td>✅</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.9</td>\n<td>✅</td>\n<td>❌</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.10</td>\n<td>✅</td>\n<td>❌</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>1.21.11</td>\n<td>✅</td>\n<td>❌</td>\n<td>❌</td>\n<td>✅</td>\n</tr>\n<tr>\n<td>26.1.x</td