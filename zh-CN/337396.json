  "content": "<html><body>\n<p><a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fmakeship\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/web/slabfish_plush.png\" alt=\"\"></a></p>\n<p><img src=\"https://i.slabfi.sh/banner/boatload.png\" alt=\"\"></p>\n<p>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fblueprint\" rel=\"nofollow\"><img alt=\"Blueprint\" src=\"https://slabfi.sh/shield/blueprint\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2f\" rel=\"nofollow\"><img alt=\"Website\" src=\"https://slabfi.sh/shield/website\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fdiscord\" rel=\"nofollow\"><img alt=\"Discord\" src=\"https://slabfi.sh/shield/discord\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fx\" rel=\"nofollow\"><img alt=\"X\" src=\"https://slabfi.sh/shield/x\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fpatreon\" rel=\"nofollow\"><img alt=\"Patreon\" src=\"https://slabfi.sh/shield/patreon\"></a>\n</p>\n<h3>📖 About:</h3>\n<p>A simple mod that provides alternatives for sailing Minecraft's oceans. Features include boats with chests, boats with furnaces, large boats, and boats with banners.</p>\n<p><img src=\"https://i.slabfi.sh/web/divider.png\" alt=\"\"></p>\n<p>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fblueprint\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/blueprint.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fabnormals_delight\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/abnormals_delight.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fallurement\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/allurement.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fatmospheric\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/atmospheric.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fautumnity\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/autumnity.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fberry_good\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/berry_good.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fboatload\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/boatload.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fbuzzier_bees\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/buzzier_bees.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fcaverns_and_chasms\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/caverns_and_chasms.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fclayworks\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/clayworks.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fendergetic\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/endergetic.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fenvironmental\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/environmental.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fgallery\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/gallery.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fincubation\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/incubation.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fneapolitan\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/neapolitan.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fpersonality\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/personality.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fpet_cemetery\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/pet_cemetery.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fsavage_and_ravage\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/savage_and_ravage.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fupgrade_aquatic\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/upgrade_aquatic.png\" width=\"96\" height=\"96\"></a>\n  <a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fcf%2fwoodworks\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/icon_crop/woodworks.png\" width=\"96\" height=\"96\"></a>\n</p>\n<p><img src=\"https://i.slabfi.sh/web/divider.png\" alt=\"\"></p>\n<p><a href=\"/linkout?remoteUrl=https%3a%2f%2fslabfi.sh%2fnodecraft\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://i.slabfi.sh/web/nodecraft.png\" alt=\"\"></a></p>\n</body></html>",
