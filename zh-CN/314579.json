  "content": "<p>&nbsp;</p><p style=\"text-align:center\"><img src=\"https://github.com/fewizz/crawl/raw/1.18/desc.gif\" alt=\"\" width=\"763\" height=\"415\"></p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:center\"><span style=\"font-size:24px\"><strong>使用方法：</strong></span></p><p style=\"text-align:center\"><span style=\"font-size:18px\">在 1.17 版本中，使用 <strong>C</strong> 键</span></p><p style=\"text-align:center\"><span style=\"font-size:18px\">在 1.16 版本中，使用 <strong>B</strong> 键</span></p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:center\"><span style=\"font-size:18px\">自版本 <strong>0.10.1</strong> 起，</span></p><p style=\"text-align:center\"><span style=\"font-size:18px\">爬行键默认<strong>未绑定</strong>。</span></p><p style=\"text-align:center\"><span style=\"font-size:18px\">您<strong>必须</strong>自行设置。</span></p><p style=\"text-align:center\"><span style=\"font-size:18px\">&nbsp;</span></p><p style=\"text-align:center\"><span style=\"color:#95a5a6\"><span style=\"font-size:18px\">如果此模组安装在服务器端，</span></span><span style=\"color:#95a5a6\"><span style=\"font-size:18px\">则<strong>所有</strong>客户端也应安装此模组。（<a href=\"https://github.com/fewizz/crawl/issues/84\" target=\"_blank\" rel=\"nofollow\">#84</a>）</span></span></p><p style=\"text-align:center\"><span style=\"font-size:18px\">&nbsp;</span></p><p style=\"text-align:center\"><span style=\"font-size:18px\">如有问题或建议，请访问：</span></p><p style=\"text-align:center\"><a href=\"https://github.com/fewizz/Crawl\" rel=\"nofollow\"><img src=\"https://i.ytimg.com/vi/OEGm7LXAN_c/maxresdefault.jpg\" alt=\"\" width=\"206\" height=\"116\"></a></p>",
  "contentType": "text/html",
  "type": "curseforge"
}
