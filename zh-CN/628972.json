  "content": "<p>&nbsp;</p><p style=\"text-align:center\"><img src=\"https://i.postimg.cc/T1cDttyv/farmers-knives-banner.png\" alt=\"farmers-knives\"></p><p>&nbsp;</p><p style=\"text-align:center\"><span style=\"font-size:18px\">为农夫乐事添加了许多模组材料制作的刀！</span></p><p>&nbsp;</p><p style=\"text-align:center\"><span style=\"font-size:24px\"><strong>支持列表：</strong></span></p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/adabranium\" target=\"_blank\" rel=\"nofollow\">Adabranium</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">振金</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">艾德曼合金</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">下界砖</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/additional-additions\" target=\"_blank\" rel=\"nofollow\">附加物</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">玫瑰金</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">镀金下界合金</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/advanced-netherite-fabric\" target=\"_blank\" rel=\"nofollow\">高级下界合金</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">下界合金-铁</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">下界合金-金</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">下界合金-绿宝石</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">下界合金-钻石</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/aphid-additions\" target=\"_blank\" rel=\"nofollow\">蚜虫附加</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">几丁质</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/betterend\" target=\"_blank\" rel=\"nofollow\">更好末地</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">萨拉合金</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">终界合金</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">永恒合金</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/betternether\" target=\"_blank\" rel=\"nofollow\">更好下界</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">金耀石</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">金耀石-钻石</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">下界红宝石</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/botania-fabric\" target=\"_blank\" rel=\"nofollow\">植物魔法</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">魔力钢</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">源钢</span></p><p style=\"text-align:center\"><span style=\"font-size:12px\">泰拉钢</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/conjuring\" target=\"_blank\" rel=\"nofollow\">魔幻召唤</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">灵魂合金</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/copper-age-backport\" target=\"_blank\" rel=\"nofollow\">铜器时代回溯</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">铜</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/create-stuff-additions\" target=\"_blank\" rel=\"nofollow\">机械动力：物品与附加</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">黄铜<br>锌</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/deeperdarker\" target=\"_blank\" rel=\"nofollow\">更深更暗</a></p><p style=\"text-align:center\"><span style=\"font-size:12px\">守卫者</span></p><p>&nbsp;</p><p style=\"text-align:center\"><a h