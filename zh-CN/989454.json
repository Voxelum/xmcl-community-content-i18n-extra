=https%253a%252f%252fmodrinth.com%252fmod%252ftough-as-nails\" target=\"_blank\" rel=\"nofollow\">Tough as Nails</a></td>\n<td style=\"text-align:left\">&gt;= v1.9.3</td>\n</tr>\n<tr>\n<td style=\"text-align:right\"><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252ftrashslot\" target=\"_blank\" rel=\"nofollow\">TrashSlot</a></td>\n<td style=\"text-align:left\">&gt;= v0.8.4</td>\n</tr>\n<tr>\n<td style=\"text-align:right\"><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252ftravelersbackpack\" target=\"_blank\" rel=\"nofollow\">旅行者背包 (Traveler's Backpack)</a></td>\n<td style=\"text-align:left\">&gt;= v1.3</td>\n</tr>\n<tr>\n<td style=\"text-align:right\"><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252ftrinkets\" target=\"_blank\" rel=\"nofollow\">饰品 (Trinkets)</a></td>\n<td style=\"text-align:left\">&gt;= v1.1</td>\n</tr>\n<tr>\n<td style=\"text-align:right\"><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fwaystones\" target=\"_blank\" rel=\"nofollow\">传送石 (Waystones)</a></td>\n<td style=\"text-align:left\">&gt;= v0.9.1</td>\n</tr>\n<tr>\n<td style=\"text-align:right\"><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fxaeros-minimap-fair\" target=\"_blank\" rel=\"nofollow\">Xaero's Minimap (Fair-Play)</a></td>\n<td style=\"text-align:left\">&gt;= v0.9</td>\n</tr>\n<tr>\n<td style=\"text-align:right\"><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fzenith\" target=\"_blank\" rel=\"nofollow\">Zenith</a></td>\n<td style=\"text-align:left\">&gt;= v0.9.1</td>\n</tr>\n<tr>\n<td style=\"text-align:right\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/zenith-attributes\" target=\"_blank\" rel=\"nofollow\">Zenith Attributes</a></td>\n<td style=\"text-align:left\">&gt;= v1.8</td>\n</tr>\n</tbody>\n</table><h3>推荐模组</h3>\n<ul>\n<li><strong><a href=\"https://www.curseforge.com/minecraft/mc-mods/raised\" target=\"_blank\" rel=\"nofollow\">Raised</a> 模组</strong>：移动快捷栏位置，避免纹理被裁剪；</li>\n<li><strong><a href=\"https://www.curseforge.com/minecraft/texture-packs/nbtpack-grass\" target=\"_blank\" rel=\"nofollow\">NBTpack 草方块插件</a> 资源包</strong>：调整物品展示角度，使具有长纹理的物品（例如剑）在圆角物品槽中看起来更加协调。</li>\n</ul>\n<h3>Minecraft 数据包版本兼容性</h3>\n<p><a href=\"/linkout?remoteUrl=https%253a%252f%252fminecraft.wiki%252fw%252fPack_format\" target=\"_blank\" rel=\"nofollow\">Minecraft 数据包格式</a></p>\n<table>\n<thead>\n<tr>\n<th>Minecraft 数据包版本</th>\n<th>Cobblemon Interface</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>9</td>\n<td>&lt;= v0.7</td>\n</tr>\n<tr>\n<td>15</td>\n<td>&gt;= v0.8</td>\n</tr>\n<tr>\n<td>34</td>\n<td>&gt;= v1.4</td>\n</tr>\n</tbody>\n</table>\n<h3>包含内容</h3>\n<p>本项目包含修改版的 <a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fresourcepack%252fpoketips\" target=\"_blank\" rel=\"nofollow\">Cobblemon 提示文本</a> 资源包。</p>\n<p><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fresourcepack%252fpoketips\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://api.mcbanners.com/banner/saved/LZrReFoiohJHWs.png\" alt=\"Banner\"></a></p>\n<h2>其他：</h2>\n<p>纹理基于 <a href=\"https://www.curseforge.com/minecraft/texture-packs/torrezx-improved-library\" target=\"_blank\" rel=\"nofollow\">Torrezx-Improved Library</a> 资源包的书籍，并受到 <a href=\"/linkout?remoteUrl=https%253a%252f%252fyoutu.be%252fSbIA8FKhwl0\" target=\"_blank\" rel=\"nofollow\">《传说阿尔宙斯》预告片</a> 开场书籍的启发</p>\n<p><a href=\"/linkout?remoteUrl=https%253a%252f%252fdiscord.com%252fchannels%252f934267676354834442%252f1091579923396820992\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3.1.0/assets/compact/social/discord-singular_vector.svg\" alt=\"Discord\"></a> 位于 <a href=\"https://discord.gg/cobblemon\" target=\"_blank\" rel=\"nofollow\">官方 Cobblemon Discord 服务器</a></p>\n<p><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fresourcepack%252fcobblemon-interface-modded\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/compact/available/modrinth_vector.svg\" alt=\"Modrinth\"></a> <a href=\"/linkout?remoteUrl=https%253a%252f%252fko-fi.com%252fM4M5K4BDR\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://cdn.jsdelivr.net/npm/@intergrav/devins-badges@3/assets/compact/donate/kofi-singular_vector.svg\" alt=\"Ko-fi\"></a></p>",
