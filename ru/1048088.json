  "content": "<p style=\"text-align:center\"><img src=\"https://media.forgecdn.net/attachments/1162/406/curseforgebannersna1-png.png\" alt=\"\" width=\"1280\" height=\"45\"></p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:center\"><img src=\"https://media.forgecdn.net/attachments/1162/789/luminia_painting_curseforge-page-png.png\" alt=\"\" width=\"595\" height=\"114\"></p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:center\"><a href=\"https://www.youtube.com/@BalModsSaga\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/1161/953/curseforge_youtubebutton-png.png\" alt=\"\" width=\"206\" height=\"46\"></a> &nbsp;<a href=\"https://discord.gg/Gbe3zj76Nq\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/1161/951/curseforge_discordbutton-png.png\" alt=\"\" width=\"266\" height=\"51\"></a> &nbsp;<a href=\"/linkout?remoteUrl=https%253a%252f%252fbalmods-saga.odoo.com%252f\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/1161/952/curseforge_websitebutton-png.png\" alt=\"\" width=\"206\" height=\"46\"></a></p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:center\"><span style=\"text-decoration:underline\"><span style=\"font-size:24px\"><strong>НОВАЯ РОСПИСЬ ДЛЯ ВАШЕГО ДОМА</strong></span></span></p><p style=\"text-align:center\"><strong><span style=\"font-size:12px\">НОВОЕ ЖЕЛАНИЕ УКРАШЕНИЯ? У НАС ЕСТЬ ТО, ЧТО ВАМ НУЖНО. ЛУМИНИЯ ПЭЙНТИНГ ПРОСТО ДОБАВЛЯЕТ НОВЫЕ РОСПИСИ, КОТОРЫЕ ПРЕДСТАВЛЯЮТ ЛУЧШИЕ МЕСТА ДЛЯ ВЫЖИВАНИЯ В МАЙНЕКРАФТЕ ПОД НАЗВАНИЕМ ЛУМИНИЯ.</span></strong></p><p style=\"text-align:center\">&nbsp;<span style=\"font-size:12px\"><strong РАЗМЕРЫ КРАСКИ ВСЕ ОДИНАКОВЫ И НЕ ИЗМЕНЯТСЯ.</strong></span></p><p style=\"text-align:center\">&nbsp;<span style=\"font-size:12px\"><strong ДЛЯ ПОЛУЧЕНИЯ ЭТИХ КРАСОК НЕ ТРЕБУЕТСЯ НОВОЕ ИЗГОТОВЛЕНИЕ, ВЫ МОЖЕТЕ ПРОСТО ИСПОЛЬЗОВАТЬ ВАНИЛЬНУЮ ФУНКЦИЮ КРАСКИ.</strong></span></p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:center\"><img src=\"https://media.forgecdn.net/attachments/1162/788/luminia_painting_curseforge_imagena2-png.png\" alt=\"\" width=\"725\" height=\"408\"></p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:center\"><img src=\"https://media.forgecdn.net/attachments/1162/407/curseforgebannersna2-png.png\" alt=\"\" width=\"1279\" height=\"45\"></p>",
