  "content": "\n\n<p style=\"text-align:center\"><span style=\"font-family:&amp;#x27\">&nbsp;</span>&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-family:&amp;#x27\"><img src=\"https://media.forgecdn.net/attachments/710/975/credits_render.png\" alt=\"Made with Blockbench Title Plugin\" width=\"4094\" height=\"743\"></span>&nbsp;</p>\n<blockquote>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\"><strong><span style=\"font-family:&amp;#x27\">Это набор текстур, изменяющий текстуры мода </span><span style=\"font-family:&amp;#x27\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/building-gadgets\" target=\"_blank\" rel=\"nofollow\">Building </a><a href=\"https://www.curseforge.com/minecraft/mc-mods/building-gadgets\" target=\"_blank\" rel=\"nofollow\">Gadgets</a> (от Direwolf20 и Error_MiKeY), чтобы они соответствовали тематике мода Create.<br><br></span></strong></span></p>\n</blockquote>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\">&nbsp;</p>\n<blockquote>\n<p style=\"text-align:center\"><span style=\"font-size:14px\"><strong><span style=\"font-family:&amp;#x27\"><img src=\"https://media.forgecdn.net/attachments/710/986/render_1440p_title.png\" alt=\"\" width=\"1142\" height=\"642\"><br></span></strong></span></p>\n</blockquote>\n<p style=\"text-align:center\">&nbsp;<span style=\"font-family:&amp;#x27\"><br></span></p>",
