  "content": "<p style=\"text-align:center\"><span style=\"text-decoration:underline;font-size:24px\"><span style=\"font-family:verdana, geneva, sans-serif;color:#930;text-decoration:underline\">Альфапак</span></span></p><ul>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старые звуки</span></span></li>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старая вода и лава</span></span></li>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старый незерак (он даже заменяет золотую руду незерака из версии 1.16)</span></span></li>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старые мечи, инструменты и доспехи (он также меняет нефритовые доспехи)<br></span></span></li>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старый тотем</span></span></li>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старая шелкербокс</span></span></li>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старые алмазные, железные и золотые блоки</span></span></li>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старая трава, грязь и листья</span></span></li>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старый булыжник</span></span></li>\n<li style=\"text-align:left\"><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старый гравий</span></span></li>\n<li><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старая еда</span></span></li>\n<li><span style=\"font-size:14px;color:#000\"><span style=\"font-family:verdana, geneva, sans-serif\">Старый обсидиан (он также меняет плачущий обсидиан)</span></span></li>\n</ul><p style=\"text-align:center\"><span style=\"text-decoration:underline;font-size:24px;color:#930\"><span style=\"font-family:verdana, geneva, sans-serif\">Скриншоты</span></span></p><p style=\"text-align:center\"><img src=\"https://i.imgur.com/YD6fY6U.jpg\"></p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:left\"><img src=\"https://i.imgur.com/Rhmu5YL.jpg\"></p><p style=\"text-align:left\">&nbsp;</p><p style=\"text-align:left\"><img src=\"https://i.imgur.com/uaAJTwP.png\"></p><p style=\"text-align:center\">&nbsp;</p>",
