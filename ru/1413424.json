  "content": "<img src=\"https://cdn.modrinth.com/data/cached_images/741666167ae3da10b02f1652bbb29f9618ef1404.png\" alt=\"BookOfDragonsV1.3Titlecard\"><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style......<img src=\"https://cdn.modrinth.com/data/cached_images/741666167ae3da10b02f1652bbb29f9618ef1404.png\" alt=\"BookOfDragonsV1.3Titlecard\"><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration:underline\"></span><span style=\"text-decoration