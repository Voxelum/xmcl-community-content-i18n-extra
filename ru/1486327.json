{
  "bodyHash": "969b7da0cf940110",
  "content": "\n\n<h1><span style=\"color:#e03e2d\">🎮 Plop &mdash; Альтернатива OptiFine для Fabric 1.20.1</span></h1>\n<p><span style=\"color:#e03e2d\">Комплексный мод для оптимизации и улучшения графики для Fabric 1.20.1.</span><br><span style=\"color:#e03e2d\"><strong>Более 120 настроек</strong>, сгруппированных в <strong>10 категорий</strong>, с полнофункциональным интерфейсом.</span></p>\n<hr>\n<h3><span style=\"color:#e67e23\">10 категорий настроек:</span></h3>\n<h3><span style=\"color:#b96ad9\">⚡ Производительность</span></h3>\n<table>\n<thead>\n<tr>\n<th><span style=\"color:#b96ad9\">Настройка</span></th>\n<th><span style=\"color:#b96ad9\">Описание</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"color:#b96ad9\">Плавный FPS</span></td>\n<td><span style=\"color:#b96ad9\">Сглаживание скачков частоты кадров</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Быстрый рендер</span></td>\n<td><span style=\"color:#b96ad9\">Оптимизация конвейера рендеринга</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Быстрая математика</span></td>\n<td><span style=\"color:#b96ad9\">Использование упрощённых математических функций</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Плавная загрузка мира</span></td>\n<td><span style=\"color:#b96ad9\">Сглаживание загрузки мира</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Ленивые чанки</span></td>\n<td><span style=\"color:#b96ad9\">Отложенная загрузка дальних чанков</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Умные анимации</span></td>\n<td><span style=\"color:#b96ad9\">Анимация только видимых текстур</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Отсечение сущностей</span></td>\n<td><span style=\"color:#b96ad9\">Отключение рендера сущностей вне поля зрения</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Обновления чанков/кадр</span></td>\n<td><span style=\"color:#b96ad9\">1-5 обновлений чанков на кадр</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Лимит FPS</span></td>\n<td><span style=\"color:#b96ad9\">0 (неограниченно) до 260</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Дистанция симуляции</span></td>\n<td><span style=\"color:#b96ad9\">5-32 чанка</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Дистанция рендера сущностей</span></td>\n<td><span style=\"color:#b96ad9\">50-500%</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Дистанция тайловых сущностей</span></td>\n<td><span style=\"color:#b96ad9\">16-256 блоков</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Рендер регионов</span></td>\n<td><span style=\"color:#b96ad9\">Включает посегментный рендер</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#b96ad9\">Оптимизация предметов/блоков</span></td>\n<td><span style=\"color:#b96ad9\">Оптимизированный рендер</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3><span style=\"color:#f1c40f\">✦ Качество / Графика</span></h3>\n<table>\n<thead>\n<tr>\n<th><span style=\"color:#f1c40f\">Настройка</span></th>\n<th><span style=\"color:#f1c40f\">Описание</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"color:#f1c40f\">Мипмаппинг 0-4x</span></td>\n<td><span style=\"color:#f1c40f\">Уровень мипмаппинга</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Тип мипмаппинга</span></td>\n<td><span style=\"color:#f1c40f\">Ближайший / Линейный / Билинейный / Трилинейный</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Сглаживание (AA)</span></td>\n<td><span style=\"color:#f1c40f\">Выкл. / 2x / 4x / 8x</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Анизотропная фильтрация</span></td>\n<td><span style=\"color:#f1c40f\">Выкл. / 2x / 4x / 8x / 16x</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Улучшенная трава</span></td>\n<td><span style=\"color:#f1c40f\">Текстура травы на боках блоков (Быстро/Красиво)</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Связанные текстуры</span></td>\n<td><span style=\"color:#f1c40f\">Объединение текстур стекла и т.д.</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Пользовательские цвета/Небо/Предметы</span></td>\n<td><span style=\"color:#f1c40f\">Поддержка пользовательских ресурспаков</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Эмиссионные текстуры</span></td>\n<td><span style=\"color:#f1c40f\">Эмиссионные (светящиеся) текстуры</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Естественные текстуры</span></td>\n<td><span style=\"color:#f1c40f\">Случайное вращение для избежания повторов</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Улучшенный снег</span></td>\n<td><span style=\"color:#f1c40f\">Снег на боках блоков</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Прозрачная вода</span></td>\n<td><span style=\"color:#f1c40f\">Полупрозрачная вода</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#f1c40f\">Случайные сущности</span></td>\n<td><span style=\"color:#f1c40f\">Случайные текстуры для сущностей</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3><span style=\"color:#236fa1\">❀ Детали / Окружение</span></h3>\n<table>\n<thead>\n<tr>\n<th><span style=\"color:#236fa1\">Настройка</span></th>\n<th><span style=\"color:#236fa1\">Описание</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"color:#236fa1\">Облака</span></td>\n<td><span style=\"color:#236fa1\">Выкл. / Быстро / Красиво</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Высота облаков</span></td>\n<td><span style=\"color:#236fa1\">Смещение высоты</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Деревья</span></td>\n<td><span style=\"color:#236fa1\">Быстро / Красиво / Умные</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Дождь/Снег</span></td>\n<td><span style=\"color:#236fa1\">Выкл. / Быстро / Красиво</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Небо / Звёзды / Солнце</span></td>\n<td><span style=\"color:#236fa1\">Вкл./Выкл.</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Туман</span></td>\n<td><span style=\"color:#236fa1\">Выкл. / Быстро / Красиво</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Вода</span></td>\n<td><span style=\"color:#236fa1\">Быстро / Красиво</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Выброшенные предметы</span></td>\n<td><span style=\"color:#236fa1\">2D / 3D</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Тени сущностей</span></td>\n<td><span style=\"color:#236fa1\">Вкл./Выкл.</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Виньетка</span></td>\n<td><span style=\"color:#236fa1\">Быстро / Красиво</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#236fa1\">Смешивание биомов</span></td>\n<td><span style=\"color:#236fa1\">0 (Выкл.) до 7 (15x15)</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3><span style=\"color:#e67e23\">♨ Анимации (Вкл./Выкл. всех одной кнопкой)</span></h3>\n<ul>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\"><strong>12 переключаемых анимаций:</strong> Вода, Лава, Огонь, Портал, Красная пыль, Взрыв, Пламя, Дым, Пустота, Ландшафт, Предметы, Текстуры</span></li>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\"><strong>9 переключаемых типов частиц:</strong> Вода, Дождь, Портал, Взрыв, Капли, Фейерверки, Костёр, Зелья, Души</span></li>\n</ul>\n<p>&nbsp;</p>\n<h3><span style=\"color:#843fa1\">☀ Освещение</span></h3>\n<table>\n<thead>\n<tr>\n<th><span style=\"color:#843fa1\">Настройка</span></th>\n<th><span style=\"color:#843fa1\">Описание</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"color:#843fa1\">Динамическое освещение</span></td>\n<td><span style=\"color:#843fa1\">Динамический свет (например, факел в руке)</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#843fa1\">Режим</span></td>\n<td><span style=\"color:#843fa1\">Выкл. / Быстро / Красиво</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#843fa1\">Плавное освещение</span></td>\n<td><span style=\"color:#843fa1\">Плавное освещение 0-100%</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#843fa1\">Гамма</span></td>\n<td><span style=\"color:#843fa1\">0.0 до 5.0 (максимальная яркость при 5.0)</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#843fa1\">Мерцание</span></td>\n<td><span style=\"color:#843fa1\">Переключение мерцания света</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3><span style=\"color:#ba372a\">☁ Погода / Туман</span></h3>\n<table>\n<thead>\n<tr>\n<th><span style=\"color:#ba372a\">Настройка</span></th>\n<th><span style=\"color:#ba372a\">Описание</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"color:#ba372a\">Плотность тумана</span></td>\n<td><span style=\"color:#ba372a\">0.0 до 2.0</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#ba372a\">Без тумана</span></td>\n<td><span style=\"color:#ba372a\">Для каждого измерения: Пещеры / Вода / Незер / Край</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#ba372a\">Интенсивность погоды</span></td>\n<td><span style=\"color:#ba372a\">0.0 до 2.0x</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#ba372a\">Улучшенный дождь/снег</span></td>\n<td><span style=\"color:#ba372a\">Более плотные частицы</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#ba372a\">Вспышки молний</span></td>\n<td><span style=\"color:#ba372a\">Вкл./Выкл.</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#ba372a\">Звуки погоды</span></td>\n<td><span style=\"color:#ba372a\">Вкл./Выкл.</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<h3><span style=\"color:#e67e23\">◎ Интерфейс / HUD</span></h3>\n<p><span style=\"color:#e67e23\"><strong>15 переключаемых элементов информации:</strong></span></p>\n<ul>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\">FPS, Координаты, Биом, Направление (с градусами)</span></li>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\">Уровень освещения, ОЗУ (с %), TPS</span></li>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\">Количество сущностей, Загруженные чанки, IP сервера</span></li>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\">Игровой день, Игровое время, Реальное время</span></li>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\">Слаймовый чанк, CPS (кликов в секунду)</span></li>\n</ul>\n<p><span style=\"color:#e67e23\"><strong>Параметры отображения:</strong></span></p>\n<ul>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\">Позиция: 4 угла экрана</span></li>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\">Масштаб: 0.5x до 3.0x</span></li>\n<li style=\"color:#e67e23\"><span style=\"color:#e67e23\">Полупрозрачный фон с регулируемой непрозрачностью</span></li>\n</ul>\n<p>&nbsp;</p>\n<h3><span style=\"color:#169179\">🔎 Масштабирование (Zoom)</span></h3>\n<table>\n<thead>\n<tr>\n<th><span style=\"color:#169179\">Настройка</span></th>\n<th><span style=\"color:#169179\">Описание</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"color:#169179\">Включить зум</span></td>\n<td><span style=\"color:#169179\">Вкл./Выкл.</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#169179\">Коэффициент</span></td>\n<td><span style=\"color:#169179\">2x до 10x</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#169179\">Плавный зум</span></td>\n<td><span style=\"color:#169179\">Плавный визуальный переход</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#169179\">Колёсико мыши = Зум</span></td>\n<td><span style=\"color:#169179\">Прокрутка для изменения масштаба</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<h3><span style=\"color:#e67e23\">✎ Расширенные настройки рендера</span></h3>\n<table>\n<thead>\n<tr>\n<th><span style=\"color:#e67e23\">Настройка</span></th>\n<th><span style=\"color:#e67e23\">Описание</span></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><span style=\"color:#e67e23\">Дальность прорисовки</span></td>\n<td><span style=\"color:#e67e23\">2-32 чанка</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#e67e23\">Режим графики</span></td>\n<td><span style=\"color:#e67e23\">Быстро / Красиво / Потрясающе</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#e67e23\">Масштаб интерфейса</span></td>\n<td><span style=\"color:#e67e23\">Авто / 1-4x</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#e67e23\">Полный экран / VSync</span></td>\n<td><span style=\"color:#e67e23\">Вкл./Выкл.</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#e67e23\">Угол обзора (FOV)</span></td>\n<td><span style=\"color:#e67e23\">30&deg; до 110&deg;</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#e67e23\">Искажение / Эффекты FOV</span></td>\n<td><span style=\"color:#e67e23\">0.0 до 1.0</span></td>\n</tr>\n<tr>\n<td><span style=\"color:#e67e23\">Яркость</span></td>\n<td><span style=\"color:#e67e23\">0.0 до 1.0</span></td>\n</tr>\n</tbody>\n</table>\n<p><span style=\"color:#e67e23\"><img src=\"https://media.forgecdn.net/attachments/description/1486327/description_a670ccd5-639f-4c71-bac6-1e2f1791f5b8.png\" alt=\"\" width=\"707\" height=\"431\"></span></p>\n<p><span style=\"color:#e67e23\"><img src=\"https://media.forgecdn.net/attachments/description/1486327/description_56c6b6fa-c955-4d52-af86-b24cbdab45f3.png\" alt=\"\" width=\"704\" height=\"219\"></span></p>\n<p><span style=\"color:#e67e23\"><img src=\"https://media.forgecdn.net/attachments/description/1486327/description_0ee96724-0ac4-4b47-986f-bda5989940d7.png\" alt=\"\" width=\"705\" height=\"130\"></span></p>\n<p><span style=\"color:#e67e23\"><img src=\"https://media.forgecdn.net/attachments/description/1486327/description_2dd6c33b-4fe7-4661-b115-45d96bca69b9.png\" alt=\"\" width=\"704\" height=\"284\"></span><br><br><br><br></p>",
