\">&nbsp; ✔️</td>\n<td style=\"width:9.40505%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp; &nbsp; ✔️</td>\n</tr>\n<tr>\n<td style=\"width:65.3728%;border-color:rgb(236, 240, 241);border-width:3px\"><strong>Шоссе с заброшенными автомобилями</strong></td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:9.40505%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp; &nbsp; ✔️</td>\n</tr>\n<tr>\n<td style=\"width:65.3728%;border-color:rgb(236, 240, 241);border-width:3px\"><strong>Ветряные турбины</strong></td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:9.40505%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp; &nbsp; ✔️</td>\n</tr>\n</tbody>\n</table><h2>&nbsp;</h2><h2><strong>Использование:</strong></h2><h3><strongОбратите внимание:</strong></h3><p>Вы можете включать этот мод в свои модпаки. Однако распространение изменённых версий этого мода строго запрещено и может повлечь за собой юридические последствия.</p><p>Мы призываем вас создавать видео на YouTube с участием этого мода, при условии, что вы упомянете название мода, предоставите ссылку на мод или включите в описание видео модпак, в котором он присутствует.</p><p>&nbsp;</p><p><strong>Уточнение по лицензии:</strong></p><p>Этот мод лицензирован как «Все права защищены», что чётко указано на этой странице CurseForge. Любые предыдущие упоминания другой лицензии (например, в файле mods.toml) были сделаны случайно и не дают разрешения на перераспределение, модификацию или повторное использование содержимого. Пожалуйста, убедитесь, что вы соблюдаете условия лицензии, изложенные здесь, на этой странице.</p><p>&nbsp;</p><p><span style=\"color:#e67e23\"><strong>(CurseForge автоматически загрузит версию TACZ. Если вам нужна версия Vics Point Blank, вам нужно зайти в раздел «версии» и скачать её.)</strong></span></p><p><span style=\"color:#e67e23\"><strong><img src=\"https://media.forgecdn.net/attachments/description/1061079/description_a195045f-6419-49c4-b58a-17589bdd23a9.png\"></strong></span></p><p>Вдохновение от <a href=\"https://www.curseforge.com/members/lughtmon/projects\" target=\"_blank\" rel=\"nofollow\">LughtMon</a></p>",
