41);border-width:3px\">&nbsp; ✔️</td>\n<td style=\"width:9.40505%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp; &nbsp; ✔️</td>\n</tr>\n<tr>\n<td style=\"width:65.3728%;border-color:rgb(236, 240, 241);border-width:3px\"><strong>Шоссе с брошенными автомобилями</strong></td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:9.40505%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp; &nbsp; ✔️</td>\n</tr>\n<tr>\n<td style=\"width:65.3728%;border-color:rgb(236, 240, 241);border-width:3px\"><strong>Ветряные турбины</strong></td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:6.32143%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp;</td>\n<td style=\"width:9.40505%;border-color:rgb(236, 240, 241);border-width:3px\">&nbsp; &nbsp; ✔️</td>\n</tr>\n</tbody>\n</table>\n<h2>&nbsp;</h2>\n<h2><strong>Использование:</strong></h2>\n<h3><strong>Обратите внимание:</strong></h3>\n<p>Вы можете включать этот мод в свои сборки. Однако распространение изменённых версий этого мода строго запрещено и может повлечь за собой юридические последствия.</p>\n<p>Мы приветствуем создание видео на YouTube с участием этого мода при условии, что вы упоминаете название мода, добавляете ссылку на него или указываете сборку, содержащую мод, в описании к вашему видео.</p>\n<p>&nbsp;</p>\n<p><strong>Уточнение лицензии:</strong></p>\n<p>Этот мод лицензирован по условиям All Rights Reserved (Все права защищены), как чётко указано на этой странице CurseForge. Любые предыдущие упоминания другой лицензии (например, в файле mods.toml) были случайными и не разрешают перераспределение, изменение или повторное использование контента. Пожалуйста, убедитесь, что вы соблюдаете условия лицензии, указанные на этой странице.</p>\n<p>&nbsp;</p>\n<p><span style=\"color:#e67e23\"><strong>(CurseForge автоматически скачает версию для TACZ. Если вам нужна версия для Vic's Point Blank, перейдите в раздел версий и скачайте её вручную.)</strong></span></p>\n<p><span style=\"color:#e67e23\"><strong><img src=\"https://media.forgecdn.net/attachments/description/1061079/description_a195045f-6419-49c4-b58a-17589bdd23a9.png\"></strong></span></p>\n<p>Вдохновение от <a href=\"https://www.curseforge.com/members/lughtmon/projects\" target=\"_blank\" rel=\"nofollow\">LughtMon</a></p>",
