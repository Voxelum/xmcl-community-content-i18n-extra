=true\" width=\"96\" height=\"96\" alt=\"Amplified Dimension\"></a> <a href=\"https://www.curseforge.com/minecraft/mc-mods/largebiomesdimension\" rel=\"nofollow\"><img src=\"https://github.com/mahmudindev/mcmod-largebiomesdimension/blob/master/common/src/main/resources/assets/largebiomesdimension/icon.png?raw=true\" width=\"96\" height=\"96\" alt=\"Large Biomes Dimension\"></a> <a href=\"https://www.curseforge.com/minecraft/mc-mods/mushroomfieldsdimension\" rel=\"nofollow\"><img src=\"https://github.com/mahmudindev/mcmod-mushroomfieldsdimension/blob/master/common/src/main/resources/assets/mushroomfieldsdimension/icon.png?raw=true\" width=\"96\" height=\"96\" alt=\"Mushroom Fields Dimension\"></a> <a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fproject%252fItO3yfpJ\" rel=\"nofollow\"><img src=\"https://github.com/mahmudindev/mcmod-beta173dimension/blob/master/common/src/main/resources/assets/beta173dimension/icon.png?raw=true\" width=\"96\" height=\"96\" alt=\"Beta 1.7.3 Dimension\"></a> <a href=\"https://www.curseforge.com/minecraft/mc-mods/desertdimension\" rel=\"nofollow\"><img src=\"https://github.com/mahmudindev/mcmod-desertdimension/blob/master/common/src/main/resources/assets/desertdimension/icon.png?raw=true\" width=\"96\" height=\"96\" alt=\"Desert Dimension\"></a> <a href=\"https://www.curseforge.com/minecraft/mc-mods/badlandsbiomesdimension\" rel=\"nofollow\"><img src=\"https://github.com/mahmudindev/mcmod-badlandsbiomesdimension/blob/master/common/src/main/resources/assets/badlandsbiomesdimension/icon.png?raw=true\" width=\"96\" height=\"96\" alt=\"Badlands Biomes Dimension\"></a> <a href=\"https://www.curseforge.com/minecraft/mc-mods/forestbiomesdimension\" rel=\"nofollow\"><img src=\"https://github.com/mahmudindev/mcmod-forestbiomesdimension/blob/master/common/src/main/resources/assets/forestbiomesdimension/icon.png?raw=true\" width=\"96\" height=\"96\" alt=\"Forest Biomes Dimension\"></a> <a href=\"/linkout?remoteUrl=https%253a%252f%2