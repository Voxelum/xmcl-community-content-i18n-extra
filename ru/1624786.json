  "content": "<h1 style=\"text-align:center\"><span style=\"text-decoration:underline\"><span style=\"color:#fff;text-decoration:underline\"><strong>Неожиданный стучащий</strong></span></span></h1>\n<p>&nbsp;</p>\n<h3 style=\"text-align:center\"><span style=\"color:#fff\">Оригинальный модуль создан <a href=\"https://www.curseforge.com/members/m_productions/projects\" target=\"_blank\" rel=\"nofollow\"><strong><span style=\"text-decoration:underline\"><span style=\"color:#3598db\">M_Productions</span></span></strong></a></span></h3>\n<h3 style=\"text-align:center\"><span style=\"color:#fff\">Текстура лица от меня [<a href=\"https://www.curseforge.com/members/rhut/projects\" target=\"_blank\" rel=\"nofollow\">rhut</a>]</span></h3>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><strong><span style=\"color:#fff\">Просто добавляет <span style=\"color:#b91200\">Кровь</span><span style=\"color:#fff\"> в Стучащего</span></span></strong></p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\"><strong><span style=\"color:#fff\"><span style=\"color:#fff\"><img src=\"https://media.forgecdn.net/attachments/description/null/description_5056b975-2256-4ccd-bc38-4f6174a09b16.png\" alt=\"просто добавляет кровь в стучащего\" width=\"493\" height=\"462\"></span></span></strong></h2>\n<h2 style=\"text-align:center\">&nbsp;</h2>\n<h2 style=\"text-align:center\">&nbsp;</h2>",
