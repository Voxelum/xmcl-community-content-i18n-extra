  "content": "<p>&nbsp;</p>\n<p style=\"text-align:center\"><img src=\"https://i.postimg.cc/T1cDttyv/farmers-knives-banner.png\" alt=\"farmers-knives\"></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:18px\">为 Farmer's Delight 添加支持多种模组材料的刀具！</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:24px\"><strong>支持的列表：</strong></span></p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/adabranium\" target=\"_blank\" rel=\"nofollow\">Adabranium</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">振金</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">艾德曼合金</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">下界砖</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/additional-additions\" target=\"_blank\" rel=\"nofollow\">Additional Additions</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">玫瑰金</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">镶金下界合金</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/advanced-netherite-fabric\" target=\"_blank\" rel=\"nofollow\">Advanced Netherite</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">下界合金铁</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">下界合金金</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">下界合金翡翠</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">下界合金钻石</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/aphid-additions\" target=\"_blank\" rel=\"nofollow\">Aphid Additions</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">几丁质</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/betterend\" target=\"_blank\" rel=\"nofollow\">BetterEnd</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">塔拉西姆</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">终焉金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">永恒金属</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/betternether\" target=\"_blank\" rel=\"nofollow\">BetterNether</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">辛辛纳提斯</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">钻石辛辛纳提斯</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">下界红宝石</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/botania-fabric\" target=\"_blank\" rel=\"nofollow\">Botania</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">曼钢</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">元素金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">地髓</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/conjuring\" target=\"_blank\" rel=\"nofollow\">Conjuring</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">灵魂合金</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/copper-age-backport\" target=\"_blank\" rel=\"nofollow\">Copper Age Backport</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">铜</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/create-stuff-additions\" target=\"_blank\" rel=\"nofollow\">Create Stuff and Additions</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">黄铜<br>锌</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/deeperdarker\" target=\"_blank\" rel=\"nofollow\">Deeper and Darker</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">监守者</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/dragonloot\" target=\"_blank\" rel=\"nofollow\">Dragon Loot</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">龙</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/simple-emerald-tools-fabric\" target=\"_blank\" rel=\"nofollow\">Easy Emerald Tools &amp; More</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">翡翠</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">红宝石</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">紫水晶</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">钢</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">黑曜石</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">铜</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:18px\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/end-reborn-mc\" rel=\"nofollow\">End Reborn</a></span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">残骸</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">羽刃</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/enderite-mod-for-fabric\" target=\"_blank\" rel=\"nofollow\">Enderite Mod</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">末影金属</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/gobber-fabric\" target=\"_blank\" rel=\"nofollow\">Gobber</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">戈伯</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">下界戈伯</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">末地戈伯</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/mythicmetals\" target=\"_blank\" rel=\"nofollow\">Mythic Metals</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\"> adamantite（阿达曼提特）</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">水族金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">班格卢姆</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">青铜</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">卡莫特</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">天界金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">铜</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">耐用钢</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">神圣金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">凯伯水晶</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">传奇班格卢姆</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">冶金金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">秘银</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">奥力哈钢</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">锇</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">钯</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">普罗米修姆</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">四元金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">鲁尼金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">星白金</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">钢</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">风暴金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">潮汐歌者</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/oh-the-biomes-youll-go-fabric\" target=\"_blank\" rel=\"nofollow\">Oh The Biomes You'll Go</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">彭多莱特</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:18px\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/progression-reborn\" rel=\"nofollow\">Progression Reborn</a></span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">铜</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">玫瑰金</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/the-twilight-forest\" target=\"_blank\" rel=\"nofollow\">The Twilight Forest</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">铁木</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">炽焰金属</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">钢叶</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">骑士金属</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/vanillabackport\" target=\"_blank\" rel=\"nofollow\">Vanilla Backport</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">铜</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/winterly\" target=\"_blank\" rel=\"nofollow\">Winterly</a></p>\n<p style=\"text-align:center\"><span style=\"font-size:12px\">冰晶大理石</span></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\"><strong>截至版本 2.1 的所有刀具：</strong></span></p>\n<p style=\"text-align:center\"><img src=\"https://i.ibb.co/8zPxdqC/image-2022-08-17-164723137.png\" alt=\"knives\"></p>\n<p style=\"text-align:center\">（不包括暮色森林、Adabranium、高级下界合金、Winterly、Mythic Metals 的潮汐歌者、Progression Reborn、End Reborn 和 Create Stuff &amp; Additions）</p>\n<p>&nbsp;&nbsp;</p>\n<p style=\"text-align:center\"><strong>致谢：</strong></p>\n<p style=\"text-align:center\">Mythic Metals 刀具纹理中出现的骷髅形象</p>\n<p>&nbsp;&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\">提出更多建议 <a href=\"https://github.com/ianm1647/farmersknives/issues/1\" rel=\"nofollow\">点击这里</a>！</span></p>\n<p>&nbsp;&nbsp;</p>\n<p style=\"text-align:center\">&nbsp;点击下方任意链接查看我的其他作品：</p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://discord.gg/qyYwHykSmE\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://i.ibb.co/KrWjv8p/discord-rectangle-500x160.png\" alt=\"Join the Discord Server\"></a></p>\n<p>&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://github.com/ianm1647/\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://i.ibb.co/vmx15sd/download.png\" alt=\"My GitHub\"></a></p>\n<p>&nbsp;</p>",
