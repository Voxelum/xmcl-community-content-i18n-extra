img src=\"https://i.imgur.com/MynoO6R.png\" width=\"410\" height=\"115\"></a></td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/sneaky-curses-forge\" rel=\"nofollow\"><img src=\"https://i.imgur.com/LgxIMFS.png\" width=\"410\" height=\"115\"></a></td>\n<td>  </td>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/trading-post\" rel=\"nofollow\"><img src=\"https://i.imgur.com/UzgNFIB.png\" width=\"410\" height=\"115\"></a></td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/better-animations-collection\" rel=\"nofollow\"><img src=\"https://i.imgur.com/OVV5lXk.png\" width=\"410\" height=\"115\"></a></td>\n<td>  </td>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/stylish-effects\" rel=\"nofollow\"><img src=\"https://i.imgur.com/fmWwWkZ.png\" width=\"410\" height=\"115\"></a></td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table><p><img src=\"https://i.imgur.com/C2JV3xu.png\" width=\"854\" height=\"14\"></p>",
