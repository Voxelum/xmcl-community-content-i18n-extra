  "content": "<p><span style=\"font-family:'comic sans ms', sans-serif;font-size:18px\">&nbsp;</span></p>\n<p><span style=\"font-family:'comic sans ms', sans-serif;font-size:18px\">-新護甲</span></p>\n<p><span style=\"font-family:'comic sans ms', sans-serif;font-size:18px\">-3種生物群系</span></p>\n<p><span style=\"font-family:'comic sans ms', sans-serif;font-size:18px\">-2個維度</span></p>\n<p><span style=\"font-family:'comic sans ms', sans-serif;font-size:18px\">-新工具</span></p>\n<p><span style=\"font-family:'comic sans ms', sans-serif;font-size:18px\">-2個首領</span></p>\n<p><span style=\"font-family:'comic sans ms', sans-serif;font-size:18px\">-3個村民</span></p>\n<p><span style=\"font-family:'comic sans ms', sans-serif;font-size:18px\">-新怪物</span></p>\n<h2><span style=\"font-size:24px\">武器：</span></h2>\n<p><span style=\"font-size:18px\">-玩具刀 傷害 6</span></p>\n<p><span style=\"font-size:18px\">-堅韌手套 傷害 8</span></p>\n<p><span style=\"font-size:18px\">-真實刀刃 傷害 176</span></p>\n<p><span style=\"font-size:18px\">-真正的真實刀刃 傷害 1001</span></p>\n<p><span style=\"font-size:18px\">-骨頭 傷害 12</span></p>\n<p><span style=\"font-size:18px\">-sans 骨頭 傷害 51</span></p>\n<h2>護甲：</h2>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-舊款芭蕾舞裙 防禦 10</span></p>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-心之櫃台 防禦 15</span></p>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-temmie armor&nbsp; 防禦 105 (胸甲:40, 褲子:35, 靴子:30)</span></p>\n<p><span style=\"font-size:36px\">怪物：</span></p>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-sans</span></p>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-papyrus</span></p>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-human</span></p>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-flowey</span></p>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-tem</span></p>\n<p><span style=\"font-size:24px;font-family:'comic sans ms', sans-serif\">首領：</span></p>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-chara</span></p>\n<p><span style=\"font-size:18px;font-family:'comic sans ms', sans-serif\">-sans 大屠杀</span></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span>&nbsp;</span></p>",
