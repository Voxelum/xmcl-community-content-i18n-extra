  "content": "\n\n<p>&nbsp;</p>\n<p><a href=\"/linkout?remoteUrl=https%253a%252f%252fwww.bisecthosting.com%252fBotany\" target=\"_blank\" rel=\"nofollow\"><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://www.bisecthosting.com/partners/custom-banners/b74a68ba-7878-4f63-8939-7763bd641272.png\" alt=\"\" width=\"900\" height=\"142\"></a></p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\"><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/uZNu4db.png\" alt=\"\" width=\"575\" height=\"225\"></p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\"><strong><br><br>Structory: Towers </strong> 為世界增添沉浸式的生物群落主題塔樓，支援 Fabric/Forge/Quilt。</span><span style=\"font-size:14px\"><br><br><strong>與 Waystones 相容。</strong><br><br><span style=\"font-size:12px\">前哨站、烽火台、海洋紀念碑柱、下界與末地塔樓等更多內容。<br></span></span></p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\"><a href=\"https://discord.gg/jfGMW8rEAa\" target=\"_blank\" rel=\"nofollow\"><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/mxP6Z3i.png\" alt=\"\" width=\"150\" height=\"29\"></a></p>\n<p style=\"text-align:center\"><a href=\"https://www.patreon.com/BotanyDev\" target=\"_blank\" rel=\"nofollow\"><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/8Ui26tY.png\" alt=\"\" width=\"150\" height=\"29\"></a></p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\">&nbsp;</span></p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\"><img src=\"https://i.imgur.com/cWwoG5T.jpg\" width=\"1920\" height=\"1080\"><img src=\"https://i.imgur.com/bOLI9vp.jpg\" width=\"1920\" height=\"1080\"><img src=\"https://i.imgur.com/ANEELAC.jpg\" width=\"1920\" height=\"1080\"><img src=\"https://i.imgur.com/0k6kSh7.jpg\" width=\"1920\" height=\"1080\"></span><img src=\"https://i.imgur.com/XagtO2C.jpg\" width=\"1920\" height=\"1080\"></p>\n<p style=\"text-align:center\">&nbsp;<br><span style=\"font-size:14px\"><strong>模組化<br></strong></span>&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\">Structory 的內容擴充套件（例如 Towers）可完全獨立安裝。<br></span></p>\n<p style=\"text-align:center\">&nbsp;<span style=\"font-size:14px\"><br><strong>相容性<br><br></strong><strong>Towers</strong> 同時與 <strong>Fabric Waystones </strong>和 <strong>Waystones</strong> 相容。</span></p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\"><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/DLuEMPr.png\" alt=\"\" width=\"493\" height=\"200\"></span></p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/structory\" target=\"_blank\" rel=\"nofollow\"><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://i.imgur.com/a6j7jHf.png\" alt=\"\" width=\"350\" height=\"50\"></a></span></p>\n<p style=\"text-align:center\">&nbsp;</p>\n<p style=\"text-align:center\"><span style=\"font-size:14px\"><br><span style=\"font-size:12px\"><strong>透過在 <a href=\"https://www.patreon.com/botanydev\" target=\"_blank\" rel=\"nofollow\">Patreon</a> 上支持我，來助力更多此類專案的開發！</strong></span></span></p>",
