-width:1px\"><strong>7</strong></th>\n<th style=\"width:16.02%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>7</strong></th>\n<th style=\"width:17.1464%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>7</strong></th>\n</tr>\n<tr>\n<th style=\"width:52.5657%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>&nbsp; 攻擊速度</strong></th>\n<th style=\"width:14.1427%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>1.1</strong></th>\n<th style=\"width:16.02%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>1.2</strong></th>\n<th style=\"width:17.1464%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>1</strong></th>\n</tr>\n<tr>\n<th style=\"width:52.5657%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>&nbsp; 耐久度</strong></th>\n<th style=\"width:14.1427%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>3,000</strong></th>\n<th style=\"width:16.02%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>1,000</strong></th>\n<th style=\"width:17.1464%;border-color:rgb(15, 155, 11);border-width:1px\"><strong>1,000</strong></th>\n</tr>\n</tbody>\n</table><div class=\"spoiler\">\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_3013d31e-a306-4254-8c8c-4d3b65baa30f.png\" width=\"357\"><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_6b96113e-5b38-4a4b-b9c7-69f357e25186.png\" width=\"357\"><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_2570b588-8748-4609-969f-8d39e5cff4a9.png\" width=\"357\"></p>\n</div><p>&nbsp;</p><hr><h1 style=\"text-align:center\"><span style=\"color:#ba0a0a\"><img src=\"https://media.forgecdn.net/attachments/description/1073742/description_73fa45c0-5496-4190-aa24-a156e946aa18.gif\" width=\"42\" height=\"42\"> <span style=\"color:#3ab623\">綠寶石</span><span style=\"color:#3ab623\">鑲邊盔甲</span> <img src=\"https://media.forgecdn.net/attachments/description/1073742/description_2f2da8f6-4958-4f90-933b-eed14d3fee98.gif\" width=\"42\" height=\"42\"></span></h1><div class=\"spoiler\">\n<h2><span style=\"color:#ad0ae4\">紫水晶：</span></h2>\n<p><span style=\"color:#ad0ae4\"><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_cb715a0c-d937-48de-b14c-78a078a37f85.png\" width=\"850\" height=\"132\"></span></p>\n<hr>\n<h2><span style=\"color:#cd601f\">銅：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_69fc29f8-8abf-4ab4-8414-682a87069778.png\" width=\"850\" height=\"133\"></p>\n<hr>\n<h2><span style=\"color:#08c9e4\">鑽石：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_3646c0a9-9bdd-4c27-aafa-fd049bb6024a.png\" width=\"850\" height=\"133\"></p>\n<hr>\n<h2><span style=\"color:#24c439\">綠寶石：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_e739c5e7-6cd2-4332-a804-05c42c3ddb73.png\" width=\"850\" height=\"133\"></p>\n<hr>\n<h2><span style=\"color:#f1c40f\">金：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_49cd324c-95f2-4090-b07a-a913db9d00e4.png\" width=\"850\" height=\"133\"></p>\n<hr>\n<h2><span style=\"color:#ced4d9\">鐵：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_aac191d9-2a6d-46eb-a34b-91dad1437c7b.png\" width=\"850\" height=\"133\"></p>\n<hr>\n<h2><span style=\"color:#2950fa\">青金石：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_94f76621-0de0-4d10-a614-456fa47ff74f.png\" width=\"850\" height=\"135\"></p>\n<hr>\n<h2><span style=\"color:#313030\">獄髓：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_e4bcf53f-d26b-47ba-9413-886d185ebe7f.png\" width=\"850\" height=\"132\"></p>\n<hr>\n<h2><span style=\"color:#ddd6d6\">石英：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_a4281f5e-61ba-4b4a-8c29-a7e658efecd9.png\" width=\"850\" height=\"135\"></p>\n<hr>\n<h2><span style=\"color:#fc1111\">紅石：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_b1ce718b-67c5-477d-af83-66e7ebdd2d36.png\" width=\"850\" height=\"134\"></p>\n<hr>\n<h2><span style=\"color:#e67e23\">樹脂：</span></h2>\n<p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_261ac0b4-2ddf-4393-9ba1-fa61548302ff.png\" width=\"850\" height=\"135\"></p>\n</div><p>&nbsp;</p><hr><p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_352e702a-54bd-4948-a97f-ecb8ec7dbb43.png\"></p><p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_39c7b4bf-6abf-4bf5-a288-0ee9969c0a38.png\" width=\"798\" height=\"678\"></p><p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_c84f9b0f-2010-4984-80fc-8a89e20ba70d.png\" width=\"813\" height=\"510\"></p><p><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_4a853063-a275-4f1a-a085-de8be05f5e75.png\" width=\"802\" height=\"389\"></p><hr><h1 style=\"text-align:center\"><span style=\"color:#18ba1d\">更新日誌：</span></h1><div class=\"spoiler\">\n<p>4.5.0 新增綠寶石盔甲飾紋，改進了遊戲內描述，並修正了部分物品的數值</p>\n<p>4.0.0 改進盔甲材質，新增兩個成就並修正其餘問題，同時加入了遊戲內的介紹說明</p>\n<p>3.5.0 新增創造模式標籤頁，修正工具與盔甲的錯誤，並優化了所有工具與盔甲的材質</p>\n<p>3.0.0 更改了所有材質的顏色</p>\n<p>2.5.0 新增錘子與挖掘機，並略微修改了大部分材質</p>\n<p>2.0.0 為模組新增成就系統</p>\n<p>1.5.0 新增萬用鎬</p>\n</div><p>&nbsp;</p><hr><h1 style=\"text-align:center\"><span style=\"color:#0dc10d\">我的其他模組：</span></h1><p><a href=\"https://www.curseforge.com/minecraft/mc-mods/only-paxel\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/description/1196993/description_981c06d9-c927-4767-b3b1-de3cdf7e9bff.gif\" width=\"380\" height=\"380\"></a>&nbsp; &nbsp; &nbsp; &nbsp; <a href=\"https://www.curseforge.com/minecraft/mc-mods/ruby-above-netherite\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/description/1196993/description_53650165-cfc9-44f9-b627-aa7884176500.gif\" width=\"380\" height=\"380\"></a></p><p><a href=\"https://www.curseforge.com/minecraft/mc-mods/only-hammers-mod\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/description/1196993/description_c86d40b9-dd72-4e14-b7ed-d6085e53689c.gif\" width=\"380\" height=\"380\"></a> &nbsp; &nbsp; &nbsp; &nbsp;<a href=\"https://www.curseforge.com/minecraft/mc-mods/superior-ores\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/description/1073848/description_a19c40e0-c7f0-4efc-8171-3236ec432043.gif\" width=\"379\" height=\"379\"></a></p><p><a href=\"https://www.curseforge.com/minecraft/mc-mods/only-excavator\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/description/1196993/description_842d686c-f50a-47ea-9c18-ac9bc93d5bf8.gif\" width=\"380\" height=\"380\"></a>&nbsp;&nbsp; &nbsp; &nbsp; &nbsp;<a href=\"https://www.curseforge.com/minecraft/mc-mods/advanced-copper\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/description/1196993/description_e7f8d29e-6c87-4cec-8f02-2416fe1c191b.png\" width=\"380\" height=\"380\"></a></p><p><a href=\"https://www.curseforge.com/minecraft/mc-mods/only-bags\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/description/1196993/description_70701335-f9ee-471a-a947-f52c825e92ac.gif\" width=\"380\" height=\"380\"></a>&nbsp;&nbsp; &nbsp; &nbsp; &nbsp;<a href=\"https://www.curseforge.com/minecraft/mc-mods/advanced-amethyst-mod\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/description/1196993/description_4689dbdb-38c7-4c1d-bc2e-39427e1cf1d0.png\" width=\"379\" height=\"379\"></a></p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/charcoal-plus\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/description/1073844/description_37572d3b-4085-44d5-a4f7-c78d77242cd8.png\" width=\"379\" height=\"379\"></a></p>",
