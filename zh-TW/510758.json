100\" height=\"100\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/darkdeath\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/avatars/1235/45/638809220133531694.png\" alt=\"黑暗死亡\" width=\"100\" height=\"100\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/darkbosses\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/avatars/1235/46/638809220279448018.png\" alt=\"黑暗首領\" width=\"100\" height=\"100\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/darkzoom\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/avatars/1235/48/638809220453447305.png\" alt=\"黑暗放大鏡\" width=\"100\" height=\"100\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/happy-go-lucky\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/avatars/1235/133/638809254724041629.png\" alt=\"幸運相伴\" width=\"100\" height=\"100\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/golden-feather\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/avatars/1235/134/638809254892853977.png\" alt=\"金羽\" width=\"100\" height=\"100\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/bread-variants\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/avatars/1235/135/638809255107312653.png\" alt=\"麵包變體\" width=\"100\" height=\"100\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/mace-variants\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/avatars/1235/136/638809255329506894.png\" alt=\"戰鎚變體\" width=\"100\" height=\"100\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/armor-stand-arms\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/avatars/1235/139/638809255519582771.png\" alt=\"盔甲座手臂\" width=\"100\" height=\"100\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/darksleep\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://media.f