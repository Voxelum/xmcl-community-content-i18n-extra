  "content": "<img src=\"https://i.imgur.com/h9dmspH.png\" alt=\"\" width=\"auto\" />\n\n<!-- Geckolib -->\n<!-- <div>\n    <hr>\n    <center>\n        <a href=\"https://modrinth.com/mod/geckolib\">\n            <img src=\"https://i.imgur.com/HHe76Ki.png\" alt=\"\" width=\"244\" height=\"82\" />\n        </a>\n    </center>\n</div> -->\n\n<!-- 描述 -->\n<div>\n    <hr>\n    <center>\n        欢迎来到我们「温馨」的小家！Cozy 是一个旨在添加各种食物、家具和生活品质提升内容的模组，为你的 Minecraft 世界增添活力！\n    </center>\n</div>\n\n<!-- 模组内容 -->\n<!-- <div>\n    <hr>\n    <div>\n        <h4>&nbsp;&nbsp;&nbsp;这个模组添加了什么？</h4>\n        <ul>\n            <li>🦆 白鸭和绿头鸭。它们生成在河流生态域</li>\n            <li>🐥 小呱：可交易的渔夫鸭！在沼泽地带发现这些小家伙！</li>\n            <li>🍰 节日水果蛋糕，小呱们超爱的甜点！</li>\n        </ul>\n    </div>\n</div> -->\n\n<!-- Discord -->\n<div>\n    <hr>\n    <center>\n        🛏️&nbsp;<a href=\"https://discord.gg/YXC6Xh82yT\">加入我们的 Discord！</a>&nbsp;🛏️\n    </center>\n</div>\n\n<!-- 制作人员 -->\n<div>\n    <hr>\n    <div>\n        <h4>&nbsp;&nbsp;&nbsp;制作人员：</h4>\n        <ul>\n            <li>🎨 Frogipher#4778（美术）</li>\n            <li>💻 ThatGravyBoat#0001（开发者）</li>\n        </ul>\n    </div>\n</div>\n\n<!-- 注释 -->\n<!-- <div>\n    <hr>\n    <center>\n        自 1.19 版本起，模组中的恐怖元素已被移除。\n    </center>\n</div> -->\n\n<!-- 使用授权：模组包、影片等 -->\n<div>\n    <hr>\n    <center>\n        只要注明出处，Cozy 可用于模组包、YouTube 影片等用途。\n    </center>\n</div>\n\n<!-- Bisecthosting -->\n<div>\n    <hr>\n    <a href=\"https://bisecthosting.com/gravy\" target=\"_blank\">\n        <img src=\"https://www.bisecthosting.com/partners/custom-banners/f2495544-8c9f-4513-a09d-cac8b85db731.png\" alt=\"\" width=\"auto\" />\n    </a>\n</div>",
