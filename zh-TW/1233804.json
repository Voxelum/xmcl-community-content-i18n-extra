  "bodyHash": "032b77d2c7695b48",
  "content": "\n\n<p><img src=\"https://cdn.modrinth.com/data/cached_images/9f1d22babad387de4381b095c41a0a1713be25da.png\" alt=\"Logo\"></p>\n<p><a href=\"https://www.curseforge.com/minecraft/mc-mods/create-cyber-goggles/files\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://cf.way2muchnoise.eu/versions/1233804(c70039).svg\" alt=\"Supported Versions\"></a>\n<a href=\"https://www.curseforge.com/minecraft/mc-mods/create-cyber-goggles\" target=\"_blank\" rel=\"nofollow\"><img src=\"http://cf.way2muchnoise.eu/1233804.svg\" alt=\"CurseForge\"></a>\n<a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fcreate-cyber-goggles\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://img.shields.io/modrinth/dt/create-cyber-goggles?logo=modrinth&label=&suffix= &style=flat&color=242629&labelColor=5ca424&logoColor=1c1c1c\" alt=\"Modrinth\"></a>\n<a href=\"https://github.com/ForgeStove/CreateCyberGoggles?tab=readme-ov-file#MIT-1-ov-file\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://img.shields.io/github/license/ForgeStove/CreateCyberGoggles?style=flat&color=900c3f\" alt=\"License\"></a>\n<a href=\"/linkout?remoteUrl=https%253a%252f%252fcrowdin.com%252fproject%252fcreate-cyber-goggles\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://badges.crowdin.net/create-cyber-goggles/localized.svg\" alt=\"Crowdin\"></a>\n<a href=\"/linkout?remoteUrl=https%253a%252f%252fdeepwiki.com%252fForgeStove%252fCreateCyberGoggles\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://deepwiki.com/badge.svg\" alt=\"Ask DeepWiki\"></a></p>\n<h2>概述 / Overview</h2>\n<blockquote>\n  <p><strong>Create: Cyber Goggles</strong> 是一款為<a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fcreate\" target=\"_blank\" rel=\"nofollow\"><strong>機械動力</strong></a>設計的客戶端附加模組，提供模組化的輔助功能。</p>\n</blockquote>\n<blockquote>\n  <p><strong>Create: Cyber Goggles</strong> 是一款為 <a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fcreate\" target=\"_blank\" rel=\"nofollow\"><strong>Create（機械動力）</strong></a> 設計的客戶端附加模組，提供模組化的輔助功能。</p>\n</blockquote>\n<h2>功能 / Features</h2>\n<h3>功能列表</h3>\n<blockquote>\n  <p>本列表適用於 1.21.1 NeoForge 版本，其他版本的功能可能會有所不同。</p>\n</blockquote>\n<h3>設定</h3>\n<h4>護目鏡</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>進階資訊顯示</td>\n<td>✅</td>\n<td>使護目鏡顯示更多詳細資訊</td>\n</tr>\n<tr>\n<td>隱藏靜態旋轉資訊</td>\n<td>❌</td>\n<td>於護目鏡介面中隱藏靜態方塊的旋轉資訊</td>\n</tr>\n<tr>\n<td>僅於護目鏡啟用時生效</td>\n<td>❌</td>\n<td>使多數額外顯示功能僅在佩戴護目鏡時啟用</td>\n</tr>\n<tr>\n<td>優化商店資訊</td>\n<td>✅</td>\n<td>優化桌布商店的資訊顯示與操作邏輯</td>\n</tr>\n<tr>\n<td>優化工廠儀表</td>\n<td>✅</td>\n<td>支援以任何方式連接與移動工廠儀表</td>\n</tr>\n<tr>\n<td>渲染旋轉粒子效果</td>\n<td>✅</td>\n<td>為目標方塊渲染旋轉粒子特效</td>\n</tr>\n<tr>\n<td>關閉介面內的護目鏡顯示</td>\n<td>✅</td>\n<td>開啟任何介面時自動關閉護目鏡顯示</td>\n</tr>\n<tr>\n<td>值框顯示時仍渲染</td>\n<td>❌</td>\n<td>當值框可見時，允許渲染護目鏡工具提示</td>\n</tr>\n<tr>\n<td>去除工具提示重複行</td>\n<td>✅</td>\n<td>移除護目鏡工具提示中相鄰的重複或近似內容行</td>\n</tr>\n<tr>\n<td>精確數值顯示</td>\n<td>✅</td>\n<td>顯示更高精度的數值資訊</td>\n</tr>\n<tr>\n<td>小數位數上限</td>\n<td>2</td>\n<td>精確數值顯示時的最大小數位數</td>\n</tr>\n</tbody>\n</table>\n<h5>遊戲模式</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>啟用護目鏡</td>\n<td>✅</td>\n<td>護目鏡總開關</td>\n</tr>\n<tr>\n<td>生存模式啟用</td>\n<td>✅</td>\n<td>於生存模式中強制啟用護目鏡</td>\n</tr>\n<tr>\n<td>創造模式啟用</td>\n<td>✅</td>\n<td>於創造模式中強制啟用護目鏡</td>\n</tr>\n<tr>\n<td>旁觀模式啟用</td>\n<td>✅</td>\n<td>於旁觀模式中強制啟用護目鏡</td>\n</tr>\n<tr>\n<td>冒險模式啟用</td>\n<td>✅</td>\n<td>於冒險模式中強制啟用護目鏡</td>\n</tr>\n</tbody>\n</table>\n<h4>工具提示</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>額外物品提示資訊</td>\n<td>✅</td>\n<td>於物品提示資訊中顯示額外資料</td>\n</tr>\n<tr>\n<td>屬性過濾器</td>\n<td>✅</td>\n<td>顯示屬性過濾器的詳細資訊</td>\n</tr>\n<tr>\n<td>背包儲存罐</td>\n<td>✅</td>\n<td>顯示背包儲存罐的額外提示資訊</td>\n</tr>\n<tr>\n<td>剪貼簿</td>\n<td>✅</td>\n<td>啟用第一人稱視角與工具提示疊加層的剪貼簿自訂渲染</td>\n</tr>\n<tr>\n<td>容器</td>\n<td>✅</td>\n<td>顯示容器內部物品</td>\n</tr>\n<tr>\n<td>粉碎控制器</td>\n<td>✅</td>\n<td>顯示粉碎控制器的產出配方與處理進度</td>\n</tr>\n<tr>\n<td>機械臂</td>\n<td>✅</td>\n<td>顯示機械臂溢出的物品</td>\n</tr>\n<tr>\n<td>置物台</td>\n<td>✅</td>\n<td>顯示置物台上的物品</td>\n</tr>\n<tr>\n<td>潛水靴</td>\n<td>✅</td>\n<td>顯示潛水靴的額外提示資訊</td>\n</tr>\n<tr>\n<td>終界箱子</td>\n<td>✅</td>\n<td>顯示終界箱子內部物品</td>\n</tr>\n<tr>\n<td>液體容器</td>\n<td>✅</td>\n<td>顯示液體容器內的流體</td>\n</tr>\n<tr>\n<td>護目鏡</td>\n<td>✅</td>\n<td>顯示護目鏡的額外提示資訊</td>\n</tr>\n<tr>\n<td>掉落物</td>\n<td>✅</td>\n<td>顯示掉落物攜帶的物品資訊</td>\n</tr>\n<tr>\n<td>控制器</td>\n<td>✅</td>\n<td>顯示控制器的頻率插槽</td>\n</tr>\n<tr>\n<td>列表過濾器</td>\n<td>✅</td>\n<td>顯示列表過濾器內的設定</td>\n</tr>\n<tr>\n<td>地圖</td>\n<td>✅</td>\n<td>顯示地圖的額外提示資訊</td>\n</tr>\n<tr>\n<td>石磨</td>\n<td>✅</td>\n<td>顯示石磨的額外提示資訊</td>\n</tr>\n<tr>\n<td>包裹實體</td>\n<td>✅</td>\n<td>顯示包裹實體內部物品</td>\n</tr>\n<tr>\n<td>包裹物品</td>\n<td>✅</td>\n<td>顯示包裹物品內部物品</td>\n</tr>\n<tr>\n<td>紅石請求器</td>\n<td>✅</td>\n<td>顯示紅石請求器的請求列表</td>\n</tr>\n<tr>\n<td>桌面 / 桌布</td>\n<td>✅</td>\n<td>顯示桌面 / 桌布上的物品</td>\n</tr>\n<tr>\n<td>工具箱</td>\n<td>✅</td>\n<td>顯示工具箱內部物品</td>\n</tr>\n<tr>\n<td>扳手</td>\n<td>✅</td>\n<td>顯示扳手的額外提示資訊</td>\n</tr>\n</tbody>\n</table>\n<h4>疊加層</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>渲染物品資訊疊加層</td>\n<td>✅</td>\n<td>允許在方塊上渲染物品資訊疊加層</td>\n</tr>\n<tr>\n<td>疊加層位移</td>\n<td>0, 0</td>\n<td>物品資訊疊加層的水平與垂直位移量</td>\n</tr>\n<tr>\n<td>提示框樣式</td>\n<td>預設</td>\n<td>選擇提示框的外觀樣式</td>\n</tr>\n<tr>\n<td>提示框主題</td>\n<td>預設</td>\n<td>選擇提示框的配色主題</td>\n</tr>\n<tr>\n<td>使用自訂顏色</td>\n<td>❌</td>\n<td>啟用物品資訊疊加層的自訂色彩</td>\n</tr>\n<tr>\n<td>背景顏色</td>\n<td>0x00000000</td>\n<td>自訂的背景色彩</td>\n</tr>\n<tr>\n<td>頂部邊框顏色</td>\n<td>0x00000000</td>\n<td>自訂的頂部邊框色彩</td>\n</tr>\n<tr>\n<td>底部邊框顏色</td>\n<td>0x00000000</td>\n<td>自訂的底部邊框色彩</td>\n</tr>\n</tbody>\n</table>\n<h5>圖解視圖</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>啟用圖解視圖</td>\n<td>❌</td>\n<td>為整個畫面套用藍圖 / 工程圖風格的後處理特效</td>\n</tr>\n<tr>\n<td>調色盤偏移</td>\n<td>0.25</td>\n<td>調色盤紋理的水平搜尋偏移 (0..1)</td>\n</tr>\n<tr>\n<td>像素化</td>\n<td>✅</td>\n<td>降低畫面解析度以呈現藍圖風格</td>\n</tr>\n<tr>\n<td>像素縮放</td>\n<td>4</td>\n<td>每個虛擬像素對應的螢幕像素數 (1=關閉)</td>\n</tr>\n<tr>\n<td>線條顏色</td>\n<td>0x2E3032</td>\n<td>邊緣輪廓色彩</td>\n</tr>\n<tr>\n<td>陰影線條顏色</td>\n<td>0x696965</td>\n<td>深度提示輪廓的陰影面色彩</td>\n</tr>\n</tbody>\n</table>\n<h4>邊框渲染</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>渲染模擬範圍框</td>\n<td>✅</td>\n<td>渲染各種方塊顯示的模擬範圍框</td>\n</tr>\n<tr>\n<td>優化連接線</td>\n<td>✅</td>\n<td>優化部分連接線的渲染方式</td>\n</tr>\n<tr>\n<td>渲染持續時間</td>\n<td>60</td>\n<td>模擬範圍框繼續渲染的時間長度 [刻]</td>\n</tr>\n<tr>\n<td>外展顏色</td>\n<td>#DDC166</td>\n<td>模擬範圍框向外擴展時顯示的色彩</td>\n</tr>\n<tr>\n<td>內收顏色</td>\n<td>#7FCDE0</td>\n<td>模擬範圍框向內收縮時顯示的色彩</td>\n</tr>\n<tr>\n<td>彩虹除錯模式</td>\n<td>❌</td>\n<td>啟用彩虹除錯模式</td>\n</tr>\n</tbody>\n</table>\n<h4>航空學</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>始終顯示質量</td>\n<td>✅</td>\n<td>顯示所有方塊的質量資訊</td>\n</tr>\n<tr>\n<td>始終顯示摩擦力</td>\n<td>❌</td>\n<td>顯示所有方塊的摩擦力資訊</td>\n</tr>\n<tr>\n<td>解除把手作用範圍限制</td>\n<td>❌</td>\n<td>解除鐵製把手的作用範圍限制</td>\n</tr>\n<tr>\n<td>自訂把手移動物理結構按鍵</td>\n<td>❌</td>\n<td>啟用自訂把手移動物理結構的按鍵綁定</td>\n</tr>\n<tr>\n<td>隨時懸掛於繩索</td>\n<td>✅</td>\n<td>無需使用扳手即可直接懸掛於繩索上</td>\n</tr>\n</tbody>\n</table>\n<h5>受力疊加層</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>啟用受力疊加層</td>\n<td>✅</td>\n<td>在目標物理結構上渲染受力 3D 箭頭與質心標記</td>\n</tr>\n<tr>\n<td>啟用受力提示框</td>\n<td>✅</td>\n<td>顯示包含質量與力值的 HUD 面板</td>\n</tr>\n<tr>\n<td>渲染質心</td>\n<td>✅</td>\n<td>渲染標示質心的方塊標記</td>\n</tr>\n<tr>\n<td>疊加層位置</td>\n<td>0, 0</td>\n<td>HUD 提示框的位置位移</td>\n</tr>\n<tr>\n<td>聚類角度閾值</td>\n<td>0.1</td>\n<td>受力方向聚類的角度差異閾值 (弧度)</td>\n</tr>\n<tr>\n<td>平滑係數</td>\n<td>0.5</td>\n<td>指數移動平均平滑係數 (0=無變化, 1=即時)</td>\n</tr>\n<tr>\n<td>重力箭頭比例</td>\n<td>0.5</td>\n<td>重力箭頭長度佔包圍盒高度的比例</td>\n</tr>\n<tr>\n<td>箭頭飽和度</td>\n<td>3</td>\n<td>控制大力值映射至箭頭長度的演算法</td>\n</tr>\n<tr>\n<td>最小箭頭長度</td>\n<td>0.1</td>\n<td>以方塊為單位的最小箭頭長度</td>\n</tr>\n<tr>\n<td>目標搜尋範圍</td>\n<td>4</td>\n<td>搜尋目標物理結構的最大射線追蹤距離 (以區塊為單位)</td>\n</tr>\n<tr>\n<td>疊加層最小像素大小</td>\n<td>0</td>\n<td>疊加層元素的最小顯示尺寸 (像素)</td>\n</tr>\n<tr>\n<td>顯示重力</td>\n<td>✅</td>\n<td>渲染重力箭頭</td>\n</tr>\n<tr>\n<td>顯示阻力</td>\n<td>✅</td>\n<td>渲染阻力箭頭</td>\n</tr>\n<tr>\n<td>顯示浮力</td>\n<td>✅</td>\n<td>渲染浮力箭頭</td>\n</tr>\n<tr>\n<td>顯示氣球升力</td>\n<td>✅</td>\n<td>渲染氣球升力箭頭</td>\n</tr>\n<tr>\n<td>顯示推進力</td>\n<td>✅</td>\n<td>渲染推進力箭頭</td>\n</tr>\n<tr>\n<td>顯示升力</td>\n<td>✅</td>\n<td>渲染升力箭頭</td>\n</tr>\n<tr>\n<td>顯示磁力</td>\n<td>✅</td>\n<td>渲染磁力箭頭</td>\n</tr>\n</tbody>\n</table>\n<h4>雜項</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>移除動力臂距離限制</td>\n<td>❌</td>\n<td>移除動力臂的作用距離限制</td>\n</tr>\n<tr>\n<td>移除請求數量限制</td>\n<td>✅</td>\n<td>移除工廠儀表與紅石請求器的請求數量限制，並優化快速滾動功能</td>\n</tr>\n<tr>\n<td>倉儲請求快捷選單</td>\n<td>✅</td>\n<td>啟用倉儲請求介面的快捷選單功能</td>\n</tr>\n<tr>\n<td>遞迴掃描藍圖</td>\n<td>✅</td>\n<td>更新藍圖列表時包含子資料夾內的藍圖檔案</td>\n</tr>\n<tr>\n<td>防止選區重置</td>\n<td>✅</td>\n<td>防止在切換手持物品時清除選區</td>\n</tr>\n<tr>\n<td>阻止過濾器自動關閉</td>\n<td>❌</td>\n<td>防止過濾器介面自動關閉</td>\n</tr>\n<tr>\n<td>無限編輯框長度</td>\n<td>❌</td>\n<td>無限編輯框長度 (實際上限為 2^31 -1)</td>\n</tr>\n<tr>\n<td>移除紙板套視野遮擋</td>\n<td>✅</td>\n<td>移除潛行狀態下紙板套造成的視野遮擋</td>\n</tr>\n<tr>\n<td>移除第一人稱背包儲存罐渲染</td>\n<td>❌</td>\n<td>移除下界合金背包儲存罐的第一人稱渲染模型</td>\n</tr>\n<tr>\n<td>啟用潛水靴</td>\n<td>✅</td>\n<td>啟用潛水靴特殊功能，停用則恢復為普通靴子</td>\n</tr>\n<tr>\n<td>修正藍圖命名限制</td>\n<td>✅</td>\n<td>儲存藍圖時支援非 ASCII 字元</td>\n</tr>\n<tr>\n<td>移除列車碰撞傷害</td>\n<td>❌</td>\n<td>阻止列車碰撞對玩家造成傷害</td>\n</tr>\n<tr>\n<td>啟用反向油門</td>\n<td>❌</td>\n<td>允許列車油門滾動突破正常最低限制（支援倒車）</td>\n</tr>\n<tr>\n<td>強制啟用飛輪優化</td>\n<td>❌</td>\n<td>強制啟用飛輪渲染後端 (可能與光影模組衝突)</td>\n</tr>\n<tr>\n<td>NBT 資料修復</td>\n<td>❌</td>\n<td>修復因 NBT 資料過長導致的遊戲崩潰，可能會影響效能</td>\n</tr>\n<tr>\n<td>顯示隨機廢料內容</td>\n<td>✅</td>\n<td>顯示序列組裝過程中產生的隨機廢料具體內容</td>\n</tr>\n</tbody>\n</table>\n<h5>鎖鏈傳動輪</h5>\n<t