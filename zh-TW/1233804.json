e>\n<h3>功能列表</h3>\n<blockquote>\n  <p>本列表適用於 1.21.1 NeoForge 版本，其他版本的功能可能會有所不同。</p>\n</blockquote>\n<h3>設定</h3>\n<h4>護目鏡</h4>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>進階資訊顯示</td>\n<td>✅</td>\n<td>使護目鏡顯示更多詳細資訊</td>\n</tr>\n<tr>\n<td>隱藏靜態旋轉資訊</td>\n<td>❌</td>\n<td>於護目鏡介面中隱藏靜態方塊的旋轉資訊</td>\n</tr>\n<tr>\n<td>僅於護目鏡啟用時生效</td>\n<td>❌</td>\n<td>使多數額外顯示功能僅在佩戴護目鏡時啟用</td>\n</tr>\n<tr>\n<td>優化商店資訊</td>\n<td>✅</td>\n<td>優化桌布商店的資訊顯示與操作邏輯</td>\n</tr>\n<tr>\n<td>優化工廠儀表</td>\n<td>✅</td>\n<td>支援以任何方式連接與移動工廠儀表</td>\n</tr>\n<tr>\n<td>渲染旋轉粒子效果</td>\n<td>✅</td>\n<td>為目標方塊渲染旋轉粒子特效</td>\n</tr>\n<tr>\n<td>關閉介面內的護目鏡顯示</td>\n<td>✅</td>\n<td>開啟任何介面時自動關閉護目鏡顯示</td>\n</tr>\n<tr>\n<td>值框顯示時仍渲染</td>\n<td>❌</td>\n<td>當值框可見時，允許渲染護目鏡工具提示</td>\n</tr>\n<tr>\n<td>去除工具提示重複行</td>\n<td>✅</td>\n<td>移除護目鏡工具提示中相鄰的重複或近似內容行</td>\n</tr>\n<tr>\n<td>精確數值顯示</td>\n<td>✅</td>\n<td>顯示更高精度的數值資訊</td>\n</tr>\n<tr>\n<td>小數位數上限</td>\n<td>2</td>\n<td>精確數值顯示時的最大小數位數</td>\n</tr>\n</tbody>\n</table>\n<h5>遊戲模式</h5>\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>描述</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>啟用護目鏡</td>\n<td>✅</td>\n<td>護目鏡總開關</td>\n</tr>\n<tr>\n<td>生存模式啟用</td>\n<td>✅</td>\n<td>於生存模式中強制啟用護目鏡</td>\n</tr>\n<tr>\n<td>創造模式啟用</td>\n<td>✅</td>\n<td>於創造模式中強制啟用護目鏡</td>\n</tr>\n<tr>\n<td>旁觀模式啟用</td>\n<td>✅</td>\n<td>於旁觀模式中強制啟用護目鏡</td>\n</tr>\n<tr>\n<td>冒險模式啟用</td>\n<td>✅</td>\n<td>於冒險模式中強制啟用護目鏡</td>\n</tr>\n</tbody>\n</table>\n<h4>工具提示</h4>\n\n<table>\n<thead>\n<tr>\n<th>功能</th>\n<th>預設值</th>\n<th>說明</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>額外物品提示資訊</td>\n<td>✅</td>\n<td>在物品提示資訊中顯示額外資訊</td>\n</tr>\n<tr>\n<td>屬性過濾器</td>\n<td>✅</td>\n<td>顯示屬性過濾器詳細資訊</td>\n</tr>\n<tr>\n<td>後背氣瓶</td>\n<td>✅</td>\n<td>顯示後背氣瓶的額外提示資訊</td>\n</tr>\n<tr>\n<td>剪貼簿</td>\n<td>✅</td>\n<td>啟用第一人稱視角與提示資訊覆蓋層的剪貼簿自訂渲染</td>\n</tr>\n<tr>\n<td>容器</td>\n<td>✅</td>\n<td>顯示容器內容</td>\n</tr>\n<tr>\n<td>粉碎控制器</td>\n<td>✅</td>\n<td>顯示粉碎控制器的輸出與進度</td>\n</tr>\n<tr>\n<td>部署器</td>\n<td>✅</td>\n<td>顯示部署器溢出的