  "content": "<p style=\"text-align:center\"><span style=\"color:#f00\"><span style=\"color:#19171c\">&nbsp;<img src=\"https://media.forgecdn.net/attachments/454/277/animaloriginsbanner4.png\"></span></span></p><p style=\"text-align:center\"><a href=\"https://www.curseforge.com/minecraft/mc-mods/pehkui\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/453/204/68747470733a2f2f63646e2e646973636f72646170702e636f.png\" alt=\"https://www.curseforge.com/minecraft/mc-mods/pehkui\" width=\"268\" height=\"90\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/origins\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/453/205/68747470733a2f2f6d656469612e646973636f72646170702e.png\" alt=\"https://www.curseforge.com/minecraft/mc-mods/origins\" width=\"269\" height=\"91\"></a><a href=\"https://www.curseforge.com/minecraft/mc-mods/fabric-api\" rel=\"nofollow\"><img src=\"https://media.forgecdn.net/attachments/453/206/68747470733a2f2f692e696d6775722e636f6d2f4f6c315463.png\" alt=\"https://www.curseforge.com/minecraft/mc-mods/fabric-api\" width=\"268\" height=\"90\"></a></p><p style=\"text-align:center\"><span style=\"color:#000\"><br><span style=\"font-size:18px\"><a href=\"https://www.curseforge.com/minecraft/modpacks/origins-infinite\" rel=\"nofollow\">查看為此製作的模組包！</a></span><br></span></p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:center\">&nbsp;</p><p style=\"text-align:center\"><span style=\"color:#000\"><span style=\"font-size:18px\">目前起源：</span></span></p><p style=\"text-align:left\"><span><img src=\"https://media.forgecdn.net/attachments/453/208/penguindescription.jpg\" width=\"400\" height=\"400\"><img src=\"https://media.forgecdn.net/attachments/453/209/reptiliandescription.jpg\" width=\"400\" height=\"400\"><img src=\"https://media.forgecdn.net/attachments/453/248/kangaroodescription.jpg\" width=\"400\" height=\"400\"><img src=\"https://media.forgecdn.net/attachments/454/249/roadrunnerdescription.jpg\" width=\"400\" height=\"400\"><img src=\"https://media.forgecdn.net/attachments/454/250/chameleondescription.jpg\" width=\"400\" height=\"400\"></span><span><img src=\"https://media.forgecdn.net/attachments/454/254/monkeydescription.jpg\" width=\"400\" height=\"400\"></span></p><p style=\"text-align:left\">&nbsp;</p><p style=\"text-align:left\"><span style=\"font-size:18px\"><strong>注意：</strong>起源卡片略有過時，以下是一些變更：</span><br><span style=\"text-decoration:underline;font-size:18px\">企鵝：</span><br><span style=\"font-size:18px\">強化：移除魚食主義特性</span><br><span style=\"text-decoration:underline;font-size:18px\">袋鼠：</span><br><span style=\"font-size:18px\">修正：修復強壯雙腿在衝刺時而非潛行時生效的問題</span><br><span style=\"text-decoration:underline;font-size:18px\">變色龍：</span><br><span style=\"font-size:18px\">強化：移除新鮮空氣需求</span><br><span style=\"font-size:18px\">重製：變色龍現在體型更小</span><br><span style=\"font-size:18px\">強化：奔跑和攀爬速度更快</span><br><span style=\"font-size:18px\">重製：隱形時會顯示玩家陰影作為辨識方式</span><br><span style=\"text-decoration:underline;font-size:18px\">爬蟲類：</span><br><span style=\"font-size:18px\">強化：現在任何皮革裝備都能防止凍結</span><br><span style=\"text-decoration:underline;font-size:18px\">猴子：</span><br><span style=\"font-size:18px\">強化：耐力持續時間大幅延長且恢復更快</span></p><p style=\"text-align:left\"><span style=\"font-size:18px\">卡片將於近期更新。</span></p><p style=\"text-align:left\">&nbsp;</p><p style=\"text-align:left\"><span style=\"font-size:18px\">變色龍起源在上次更新中已重新設計（再次）。若在多人模式中仍無法正常運作，隱形能力將完全重製。</span></p><p style=\"text-align:left\">&nbsp;</p><p>&nbsp;<span style=\"font-size:24px\">感謝 <strong>BLIPS</strong>&nbsp;提供走鵑起源。&nbsp;</span><span><br><img style=\"display:block;margin-left:auto;margin-right:auto\" src=\"https://media.forgecdn.net/attachments/454/356/questions.png\" width=\"549\" height=\"252\"><br></span></p><p>&nbsp;</p><p><span><a href=\"/linkout?remoteUrl=https%253a%252f%252fscalacube.com%252fp%252f_hosting_server_minecraft%252f3837999\" target=\"_blank\" rel=\"nofollow\"><img src=\"https://scalacube.com/images/banners/modpack.jpg\" alt=\"\" width=\"1115\" height=\"176\"></a></span></p><p>&nbsp;</p>",
