  "content": "\n\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/deleteworldstotrash/banner.png\" width=\"854\" height=\"240\"></p>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/deleteworldstotrash/strip.png\" width=\"854\" height=\"14\"></p>\n<p style=\"text-align:center;line-height:36px\"><a href=\"/linkout?remoteUrl=https%253a%252f%252flunapixel.studio%252fdiscord\" rel=\"nofollow\"><img src=\"https://img.shields.io/static/v1?label=&message=Discord&color=ECEBE6&labelColor=2F4858&style=for-the-badge&logo=discord&logoColor=white\" width=\"117\" height=\"28\"></a>&emsp;<a href=\"/linkout?remoteUrl=https%253a%252f%252fx.com%252fFusseel\" rel=\"nofollow\"><img src=\"https://img.shields.io/static/v1?label=&message=Twitter&color=ECEBE6&labelColor=2F4858&style=for-the-badge&logo=x&logoColor=white\" width=\"116\" height=\"28\"></a>&emsp;<a href=\"https://www.youtube.com/@heyitsfuzs\" rel=\"nofollow\"><img src=\"https://img.shields.io/static/v1?label=&message=YouTube&color=ECEBE6&labelColor=2F4858&style=for-the-badge&logo=youtube&logoColor=white\" width=\"118\" height=\"28\"></a>&emsp;<a href=\"https://github.com/Fuzss\" rel=\"nofollow\"><img src=\"https://img.shields.io/static/v1?label=&message=GitHub&color=ECEBE6&labelColor=2F4858&style=for-the-badge&logo=github&logoColor=white\" width=\"108\" height=\"28\"></a>&emsp;<a href=\"https://www.curseforge.com/members/fuzs_\" rel=\"nofollow\"><img src=\"https://img.shields.io/static/v1?label=&message=CurseForge&color=ECEBE6&labelColor=2F4858&style=for-the-badge&logo=curseforge&logoColor=white\" width=\"143\" height=\"28\"></a>&emsp;<a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fuser%252fFuzs\" rel=\"nofollow\"><img src=\"https://img.shields.io/static/v1?label=&message=Modrinth&color=ECEBE6&labelColor=2F4858&style=for-the-badge&logo=modrinth&logoColor=white\" width=\"129\" height=\"28\"></a></p>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/deleteworldstotrash/strip.png\" width=\"854\" height=\"14\"></p>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/commons/headers/about.png\" width=\"854\" height=\"32\"></p>\n<p><strong><span style=\"font-size:14px\">將世界移至垃圾桶</span></strong><span style=\"font-size:14px\"> 改變了 Minecraft 中刪除世界的方式。📁 它不會永久刪除世界，而是將其移至系統的垃圾桶或回收筒，讓你在改變主意時有機會恢復。</span></p>\n<p><span style=\"font-size:14px\">不再擔心意外遺失或永久性的操作失誤。🧠 如果某個世界其實很重要，你依然可以稍後輕鬆地從垃圾桶中將其還原。</span></p>\n<p><span style=\"font-size:14px\">簡單、安全，專為讓你免於後悔而設計。✨</span></p>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/deleteworldstotrash/strip.png\" width=\"854\" height=\"14\"></p>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/commons/headers/installation.png\" width=\"854\" height=\"32\"></p>\n<p><strong><span style=\"font-size:14px\">⏩ </span></strong><strong><span style=\"font-size:14px\">必須安裝於客戶端</span></strong></p>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/deleteworldstotrash/strip.png\" width=\"854\" height=\"14\"></p>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/commons/headers/credits.png\" width=\"854\" height=\"32\"></p>\n<p><span style=\"font-size:14px\">🌟 </span><span style=\"font-size:14px\">感謝 </span><a href=\"/linkout?remoteUrl=https%253a%252f%252fwww.reddit.com%252fuser%252fK3nchikka00\" rel=\"nofollow\"><span style=\"font-size:14px\">K3nchikka00</span></a><span style=\"font-size:14px\"> 在 </span><a href=\"/linkout?remoteUrl=https%253a%252f%252fwww.reddit.com%252fr%252fminecraftsuggestions%252fcomments%252fmvaahq%252fif_a_minecraft_world_gets_deleted_it_goes_into%252f\" rel=\"nofollow\"><span style=\"font-size:14px\">Reddit</span></a><span style=\"font-size:14px\"> 上提出此功能建議。</span></p>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/deleteworldstotrash/strip.png\" width=\"854\" height=\"14\"></p>\n<table style=\"text-align:center\">\n<tbody>\n<tr>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/diagonal-fences\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/diagonalfences/banner.png\" width=\"410\" height=\"115\"></a></td>\n<td>&emsp;&emsp;</td>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/illager-invasion\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/illagerinvasion/banner.png\" width=\"410\" height=\"115\"></a></td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/trading-post\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/tradingpost/banner.png\" width=\"410\" height=\"115\"></a></td>\n<td>&emsp;&emsp;</td>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/air-hop\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/airhop/banner.png\" width=\"410\" height=\"115\"></a></td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/new-paper-doll\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/paperdoll/banner.png\" width=\"410\" height=\"115\"></a></td>\n<td>&emsp;&emsp;</td>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/horse-expert\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/horseexpert/banner.png\" width=\"410\" height=\"115\"></a></td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/metal-bundles\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/metalbundles/banner.png\" width=\"410\" height=\"115\"></a></td>\n<td>&emsp;&emsp;</td>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/mutant-monsters\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/mutantmonsters/banner.png\" width=\"410\" height=\"115\"></a></td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n</tr>\n<tr>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/fast-item-frames\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/fastitemframes/banner.png\" width=\"410\" height=\"115\"></a></td>\n<td>&emsp;&emsp;</td>\n<td><a href=\"https://www.curseforge.com/minecraft/mc-mods/visual-workbench\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/visualworkbench/banner.png\" width=\"410\" height=\"115\"></a></td>\n</tr>\n<tr>\n<td>&nbsp;</td>\n</tr>\n</tbody>\n</table>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/deleteworldstotrash/strip.png\" width=\"854\" height=\"14\"></p>\n<p><a href=\"/linkout?remoteUrl=https%253a%252f%252flunapixel.studio%252fdiscord\" rel=\"nofollow\"><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/commons/studio.png\" width=\"854\" height=\"240\"></a></p>\n<p><img src=\"https://raw.githubusercontent.com/Fuzss/modresources/main/pages/data/deleteworldstotrash/strip.png\" width=\"854\" height=\"14\"></p>",
