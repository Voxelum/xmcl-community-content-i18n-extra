th.com%252fmod%252fenchancement\" target=\"_blank\" rel=\"nofollow\">Enchancements</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/enchanting-infuser\" target=\"_blank\" rel=\"nofollow\">Enchanting Infuser</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fentitytexturefeatures\" target=\"_blank\" rel=\"nofollow\">Entity Texture Features</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fexposure\" target=\"_blank\" rel=\"nofollow\">Exposure</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/ex-pattern-provider\" target=\"_blank\" rel=\"nofollow\">ExtendedAE</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/extreme-sound-muffler\" target=\"_blank\" rel=\"nofollow\">Extreme sound muffler (Forge)</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252ffabricmc.net%252f\" target=\"_blank\" rel=\"nofollow\">Fabric</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/farmers-delight\" target=\"_blank\" rel=\"nofollow\">Farmer's Delight</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/ice-and-fire-dragons\" target=\"_blank\" rel=\"nofollow\">Ice and Fire: Dragons</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/immersive-aircraft\" target=\"_blank\" rel=\"nofollow\">Immersive Aircraft [Fabric/Forge]</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fin-game-account-switcher\" target=\"_blank\" rel=\"nofollow\">In-Game Account Switcher</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/inmis\" target=\"_blank\" rel=\"nofollow\">Inmis</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/inventorio\" target=\"_blank\" rel=\"nofollow\">Inventorio</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252finventory-management\" target=\"_blank\" rel=\"nofollow\">Inventory Management</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/inventory-profiles-next\" target=\"_blank\" rel=\"nofollow\">Inventory Profiles Next</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252firon-chests\" target=\"_blank\" rel=\"nofollow\">Iron Chests</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/iron-furnaces\" target=\"_blank\" rel=\"nofollow\">Iron Furnaces</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fplugin%252fitemswapper\" target=\"_blank\" rel=\"nofollow\">ItemSwapper</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/jei\" target=\"_blank\" rel=\"nofollow\">JEI</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/jobsaddon\" target=\"_blank\" rel=\"nofollow\">JobsAddon</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/just-leveling\" target=\"_blank\" rel=\"nofollow\">Just Leveling</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/language-reload\" target=\"_blank\" rel=\"nofollow\">Language Reload</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/levelz\" target=\"_blank\" rel=\"nofollow\">LevelZ</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/libz\" target=\"_blank\" rel=\"nofollow\">LibZ</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/merequester\" target=\"_blank\" rel=\"nofollow\">ME Requester</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/mega-cells\" target=\"_blank\" rel=\"nofollow\">MEGA Cells</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/modmenu\" target=\"_blank\" rel=\"nofollow\">Mod Menu</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/moving-elevators\" target=\"_blank\" rel=\"nofollow\">Moving Elevators</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/refurbished-furniture\" target=\"_blank\" rel=\"nofollow\">MrCrayfish's Furniture Mod: Refurbished</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fmusic-notification\" target=\"_blank\" rel=\"nofollow\">Music Notification</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/mythicmetals-decorations\" target=\"_blank\" rel=\"nofollow\">Mythic Metals Decorations</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/new-nether-chest\" target=\"_blank\" rel=\"nofollow\">Nether Chested [Forge & Fabric]</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/no-chat-reports\" target=\"_blank\" rel=\"nofollow\">NoChatReports</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/paladins-furniture\" target=\"_blank\" rel=\"nofollow\">Paladin's Furniture</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/quark\" target=\"_blank\" rel=\"nofollow\">Quark</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/raised\" target=\"_blank\" rel=\"nofollow\">Raised</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/roughly-enough-items\" target=\"_blank\" rel=\"nofollow\">Roughly Enough Items (REI)</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252funiversal-sawmill\" target=\"_blank\" rel=\"nofollow\">Sawmill</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fshulkerboxtooltip\" target=\"_blank\" rel=\"nofollow\">ShulkerBoxTooltip</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/simple-uncrafting-table-fabric\" target=\"_blank\" rel=\"nofollow\">Simple Uncrafting Table</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/simple-voice-chat\" target=\"_blank\" rel=\"nofollow\">Simple Voice Chat</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/sophisticated-backpacks\" target=\"_blank\" rel=\"nofollow\">Sophisticated Backpacks</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/sophisticated-storage\" target=\"_blank\" rel=\"nofollow\">Sophisticated Storage</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/storage-drawers\" target=\"_blank\" rel=\"nofollow\">Storage Drawers</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fsupplementaries\" target=\"_blank\" rel=\"nofollow\">Supplementaries</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/the-twilight-forest\" target=\"_blank\" rel=\"nofollow\">The Twilight Forest</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252ftoms-storage\" target=\"_blank\" rel=\"nofollow\">Tom's Simple Storage Mod</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/trashslot\" target=\"_blank\" rel=\"nofollow\">TrashSlot</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/travelers-backpack-fabric\" target=\"_blank\" rel=\"nofollow\">Traveler's Backpack</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/trinkets\" target=\"_blank\" rel=\"nofollow\">Trinkets (Fabric)</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/useful-backpacks\" target=\"_blank\" rel=\"nofollow\">Useful Backpacks</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fnotebook\" target=\"_blank\" rel=\"nofollow\">Vanilla Notebook</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/waystones\" target=\"_blank\" rel=\"nofollow\">Waystones</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fmod%252fyyzs-backpack\" target=\"_blank\" rel=\"nofollow\">yyz's backpack</a></li>\n</ul>\n<h2>連結</h2>\n<ul>\n<li><a href=\"https://www.patreon.com/AmongstReality\" target=\"_blank\" rel=\"nofollow\">Patreon</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fbuymeacoffee.com%252famongstreality\" target=\"_blank\" rel=\"nofollow\">Buy Me a Coffee</a></li>\n<li><a href=\"https://www.curseforge.com/minecraft/mc-mods/advancedae\" target=\"_blank\" rel=\"nofollow\">CurseForge</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fwww.planetminecraft.com%252fmember%252famongstreality%252f\" target=\"_blank\" rel=\"nofollow\">Planet Minecraft</a></li>\n<li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fuser%252fAmongstReality\" target=\"_blank\" rel=\"nofollow\">Modrinth</a></li>\n</ul>\n<h2>使用條款</h2>\n<div class=\"spoiler\"><p>版權所有 © Unique Dark</p><p>作者：AmongstReality</p><p>作者在不同平台的頁面連結：</p><ul><li><a href=\"https://www.patreon.com/c/AmongstReality\" rel=\"nofollow\">Patreon</a></li><li><a href=\"/linkout?remoteUrl=https%253a%252f%252fwww.buymeacoffee.com%252famongstreality\" rel=\"nofollow\">BuyMeACoffee</a></li><li><a href=\"https://www.curseforge.com/members/amongstreality/projects\" rel=\"nofollow\">CurseForge</a></li><li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fuser%252fAmongstReality\" rel=\"nofollow\">Modrinth</a></li><li><a href=\"/linkout?remoteUrl=https%253a%252f%252fwww.planetminecraft.com%252fmember%252famongstreality%252f\" rel=\"nofollow\">Planet Minecraft</a></li></ul><p>您可以使用我的資源的情況：</p><ul><li>在 Modrinth 或 CurseForge 上的公開整合包中。</li><li>若您想為資源包添加模組支援作為附加模組。若如此操作，您必須加入明確的歸屬聲明，並包含原始資源包的連結。</li><li>對原始資源包進行的任何私人修改。</li></ul><p>禁止使用我的資源的情況：</p><ul><li>在 Bedrock Marketplace（基岩版市場）上進行分發。</li><li>設置付費牆（例如 Patreon）。</li><li>在任何平台上分發原始或修改過的資源。</li></ul><p>該資源包在不同平台的頁面連結：</p><ul><li><a href=\"https://www.curseforge.com/minecraft/texture-packs/unique-dark\" rel=\"nofollow\">CurseForge</a></li><li><a href=\"/linkout?remoteUrl=https%253a%252f%252fmodrinth.com%252fresourcepack%252funique-dark\" rel=\"nofollow\">Modrinth</a></li></ul></div>",
